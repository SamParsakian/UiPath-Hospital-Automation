        <Assign x:TypeArguments="x:String" DisplayName="Build Created Text" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[replyText]" Value="[String.Join(vbCrLf, {&quot;Hej,&quot;, &quot;&quot;, &quot;Kontot för &quot; &amp; in_FullName &amp; &quot; är klart.&quot;, &quot;&quot;, &quot;Användarnamn: &quot; &amp; in_UserPrincipalName, &quot;Avdelning: &quot; &amp; in_Department &amp; &quot; (gruppen &quot; &amp; in_Department &amp; &quot; - Personal)&quot;, &quot;Startdatum: &quot; &amp; in_StartDate, &quot;&quot;, &quot;Det första lösenordet lämnas ut av IT-servicedesk på den första arbetsdagen.&quot;, &quot;&quot;, &quot;Med vänlig hälsning&quot;, &quot;IT-avdelningen&quot;, &quot;&quot;, &quot;Detta mejl skickades av roboten.&quot;})]" />
