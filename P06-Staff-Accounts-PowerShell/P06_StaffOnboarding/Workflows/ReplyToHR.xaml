          <Assign x:TypeArguments="x:String" DisplayName="Build Error Text" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[replyText]" Value="[String.Join(vbCrLf, {&quot;Hej,&quot;, &quot;&quot;, &quot;Kontot för &quot; &amp; in_FullName &amp; &quot; kunde inte skapas.&quot;, &quot;Orsak: &quot; &amp; in_Message, &quot;&quot;, &quot;IT kontrollerar förfrågan och återkommer.&quot;, &quot;&quot;, &quot;Med vänlig hälsning&quot;, &quot;IT-avdelningen&quot;, &quot;&quot;, &quot;Detta mejl skickades av roboten.&quot;})]" />
