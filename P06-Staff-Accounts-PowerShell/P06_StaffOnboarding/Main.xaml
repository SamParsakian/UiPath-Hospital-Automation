                      <umam:MoveEmailConnections ConnectionId="1c702018-5e37-436e-8ec9-9ba68419b88b" CreateFolderIfMissing="False" DisplayName="Move Request To Done Folder" Email="[email]" IncludeAttachments="None" UseConnectionService="True" sap2010:WorkflowViewState.IdRef="MoveEmailConnections_1">
