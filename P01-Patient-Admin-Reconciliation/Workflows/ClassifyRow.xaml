  </Assign.To>
  <Assign.Value>
    <InArgument x:TypeArguments="x:Int32">[If(in_Cases IsNot Nothing, in_Cases.AsEnumerable().Count(Function(r) r(&quot;sender&quot;).ToString() = in_RefSender), 0)]</InArgument>
  </Assign.Value>
