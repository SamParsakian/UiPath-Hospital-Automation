  </Assign.To>
  <Assign.Value>
    <InArgument x:TypeArguments="x:String">[If(in_Patients IsNot Nothing AndAlso ownBirth &lt;&gt; &quot;&quot;, String.Join(&quot;, &quot;, in_Patients.AsEnumerable().Where(Function(r) r(&quot;patient_name&quot;).ToString() = in_PatientName AndAlso r(&quot;birth_date&quot;).ToString() = ownBirth AndAlso r(&quot;patient_id&quot;).ToString() &lt;&gt; in_PatientId).Select(Function(r) r(&quot;patient_id&quot;).ToString())), &quot;&quot;)]</InArgument>
  </Assign.Value>
</Assign>
<Assign x:TypeArguments="x:String" DisplayName="Find Cases From Same Sender" sap2010:WorkflowViewState.IdRef="Assign_103">
