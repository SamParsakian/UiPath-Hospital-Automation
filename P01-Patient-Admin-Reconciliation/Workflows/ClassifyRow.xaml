<Assign x:TypeArguments="x:String" DisplayName="Find Own Birth Date" sap2010:WorkflowViewState.IdRef="Assign_101">
  <Assign.To>
    <OutArgument x:TypeArguments="x:String">[ownBirth]</OutArgument>
  </Assign.To>
  <Assign.Value>
    <InArgument x:TypeArguments="x:String">[If(in_Patients IsNot Nothing, String.Join(&quot;&quot;, in_Patients.AsEnumerable().Where(Function(r) r(&quot;patient_id&quot;).ToString() = in_PatientId).Select(Function(r) r(&quot;birth_date&quot;).ToString())), &quot;&quot;)]</InArgument>
  </Assign.Value>
</Assign>
<Assign x:TypeArguments="x:String" DisplayName="Find Duplicate Patients" sap2010:WorkflowViewState.IdRef="Assign_102">
