    <OutArgument x:TypeArguments="x:String">[sameSenderIds]</OutArgument>
  </Assign.To>
  <Assign.Value>
    <InArgument x:TypeArguments="x:String">[If(in_Cases IsNot Nothing, String.Join(&quot; and &quot;, in_Cases.AsEnumerable().Where(Function(r) r(&quot;sender&quot;).ToString() = in_RefSender).Select(Function(r) r(&quot;case_id&quot;).ToString())), &quot;&quot;)]</InArgument>
  </Assign.Value>
</Assign>
