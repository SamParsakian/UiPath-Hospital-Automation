  </ui:ForEachRow.Body>
</ui:ForEachRow>
<Assign x:TypeArguments="sdt:DataTable" DisplayName="Sort by Row Number" sap2010:WorkflowViewState.IdRef="Assign_416">
  <Assign.To><OutArgument x:TypeArguments="sdt:DataTable">[dtReport]</OutArgument></Assign.To>
  <Assign.Value><InArgument x:TypeArguments="sdt:DataTable">[dtReport.AsEnumerable().OrderBy(Function(r) CInt(r(&quot;row_no&quot;))).CopyToDataTable()]</InArgument></Assign.Value>
</Assign>
<Assign x:TypeArguments="x:Boolean" DisplayName="Create Report Folder" sap2010:WorkflowViewState.IdRef="Assign_417">
