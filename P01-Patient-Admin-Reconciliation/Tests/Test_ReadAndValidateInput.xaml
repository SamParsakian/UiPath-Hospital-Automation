  <Sequence DisplayName="Test Read and Validate Input" sap2010:WorkflowViewState.IdRef="Sequence_20">
    <Sequence.Variables>
      <Variable x:TypeArguments="sdt:DataTable" Name="dtValid" />
      <Variable x:TypeArguments="sdt:DataTable" Name="dtRejected" />
      <Variable x:TypeArguments="x:String" Name="actualValid" />
      <Variable x:TypeArguments="x:String" Name="actualRejected" />
    </Sequence.Variables>
    <ui:InvokeWorkflowFile DisplayName="Run Read and Validate Input" UnSafe="False" WorkflowFileName="Workflows\ReadAndValidateInput.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_20">
      <ui:InvokeWorkflowFile.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="x:String" x:Key="in_CsvPath">["TestData\patient_admin_input.csv"]</InArgument>
          <OutArgument x:TypeArguments="sdt:DataTable" x:Key="out_ValidRows">[dtValid]</OutArgument>
          <OutArgument x:TypeArguments="sdt:DataTable" x:Key="out_RejectedRows">[dtRejected]</OutArgument>
        </scg:Dictionary>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <Assign x:TypeArguments="x:String" DisplayName="Valid Row Numbers" sap2010:WorkflowViewState.IdRef="Assign_20">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[actualValid]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(",", dtValid.AsEnumerable().Select(Function(r) r("row_no").ToString()))]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Rejected Rows With Reason" sap2010:WorkflowViewState.IdRef="Assign_21">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[actualRejected]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(" | ", dtRejected.AsEnumerable().Select(Function(r) r("row_no").ToString() &amp; ": " &amp; r("reject_reason").ToString()))]</InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="Are the Results as Expected?" sap2010:WorkflowViewState.IdRef="If_20">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">[actualValid = "1,2,3,4,5,6,7" AndAlso actualRejected = "8: referral_id is empty | 9: referral_id has the wrong format | 10: Same row appears earlier in the file"]</InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_21">
          <ui:LogMessage DisplayName="Log Test Passed" Level="Info" Message="TEST PASSED: Read and Validate Input (7 valid, 3 rejected)" sap2010:WorkflowViewState.IdRef="LogMessage_20" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_22">
          <Throw DisplayName="Throw Test Failed" sap2010:WorkflowViewState.IdRef="Throw_20">
            <Throw.Exception>
              <InArgument x:TypeArguments="s:Exception">[New Exception("TEST FAILED. Valid rows: " &amp; actualValid &amp; ". Rejected rows: " &amp; actualRejected)]</InArgument>
            </Throw.Exception>
          </Throw>
        </Sequence>
      </If.Else>
    </If>
