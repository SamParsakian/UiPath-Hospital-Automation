  <Sequence DisplayName="Test Reconcile Rows" sap2010:WorkflowViewState.IdRef="Sequence_300">
    <Sequence.Variables>
      <Variable x:TypeArguments="sdt:DataTable" Name="dtValid" />
      <Variable x:TypeArguments="sdt:DataTable" Name="dtRejected" />
      <Variable x:TypeArguments="sdt:DataTable" Name="dtResults" />
      <Variable x:TypeArguments="sdt:DataTable" Name="dtExpected" />
      <Variable x:TypeArguments="x:String" Name="actualText" />
      <Variable x:TypeArguments="x:String" Name="expectedText" />
    </Sequence.Variables>
    <ui:InvokeWorkflowFile DisplayName="Run Read and Validate Input" UnSafe="False" WorkflowFileName="Workflows\ReadAndValidateInput.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_300">
      <ui:InvokeWorkflowFile.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="x:String" x:Key="in_CsvPath">["TestData\patient_admin_input.csv"]</InArgument>
          <OutArgument x:TypeArguments="sdt:DataTable" x:Key="out_ValidRows">[dtValid]</OutArgument>
          <OutArgument x:TypeArguments="sdt:DataTable" x:Key="out_RejectedRows">[dtRejected]</OutArgument>
        </scg:Dictionary>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:InvokeWorkflowFile DisplayName="Run Reconcile Rows" UnSafe="False" WorkflowFileName="Workflows\ReconcileRows.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_301">
      <ui:InvokeWorkflowFile.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="sdt:DataTable" x:Key="in_ValidRows">[dtValid]</InArgument>
          <OutArgument x:TypeArguments="sdt:DataTable" x:Key="out_Results">[dtResults]</OutArgument>
        </scg:Dictionary>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:ReadCsvFile DisplayName="Read Expected Results" DataTable="[dtExpected]" Delimitator="Semicolon" DelimitatorForViewModel="Semicolon" Encoding="utf-8" FilePath="TestData\expected_results.csv" IncludeColumnNames="True" sap2010:WorkflowViewState.IdRef="ReadCsvFile_300" />
    <Assign x:TypeArguments="x:String" DisplayName="Actual Results" sap2010:WorkflowViewState.IdRef="Assign_300">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[actualText]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(" | ", dtResults.AsEnumerable().Select(Function(r) r("row_no").ToString() &amp; ":" &amp; r("result").ToString() &amp; ":" &amp; r("outcome").ToString()))]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign x:TypeArguments="x:String" DisplayName="Expected Results" sap2010:WorkflowViewState.IdRef="Assign_301">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[expectedText]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Join(" | ", dtExpected.AsEnumerable().Where(Function(e) dtValid.AsEnumerable().Any(Function(v) v("row_no").ToString() = e("row_no").ToString())).Select(Function(e) e("row_no").ToString() &amp; ":" &amp; e("result").ToString() &amp; ":" &amp; e("outcome").ToString()))]</InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="Are the Results as Expected?" Condition="[actualText = expectedText]" sap2010:WorkflowViewState.IdRef="If_300">
      <If.Then>
        <ui:LogMessage DisplayName="Log Test Passed" Level="Info" Message="[&quot;TEST PASSED: Reconcile Rows (&quot; &amp; dtResults.Rows.Count.ToString() &amp; &quot; rows)&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_300" />
      </If.Then>
      <If.Else>
        <Throw DisplayName="Throw Test Failed" sap2010:WorkflowViewState.IdRef="Throw_300">
          <Throw.Exception>
            <InArgument x:TypeArguments="s:Exception">[New Exception("TEST FAILED. Expected: " &amp; expectedText &amp; ". Actual: " &amp; actualText)]</InArgument>
          </Throw.Exception>
        </Throw>
      </If.Else>
    </If>
  </Sequence>
