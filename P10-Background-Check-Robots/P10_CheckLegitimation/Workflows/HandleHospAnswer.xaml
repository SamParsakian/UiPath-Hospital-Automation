  <Sequence DisplayName="Handle HOSP Answer" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="tempFolder" />
      <Variable x:TypeArguments="ummm:O365AttachmentLocalItem[]" Name="attachments" />
      <Variable x:TypeArguments="x:String" Name="pdfText" />
      <Variable x:TypeArguments="x:String" Name="dnr" />
      <Variable x:TypeArguments="x:String" Name="licenceStatus" />
      <Variable x:TypeArguments="x:String" Name="restrictions" />
      <Variable x:TypeArguments="x:String" Name="licenceDate" />
      <Variable x:TypeArguments="x:String" Name="checkStatus" />
      <Variable x:TypeArguments="x:String" Name="checkResult" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_PdfMetadata" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_NewValues" />
    </Sequence.Variables>
    <Assign x:TypeArguments="x:String" DisplayName="Get Temp Folder" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[tempFolder]" Value="[Environment.ExpandEnvironmentVariables(in_Config(&quot;TempFolder&quot;).ToString)]" />
    <ui:CreateDirectory ContinueOnError="{x:Null}" Output="{x:Null}" DisplayName="Create Temp Folder" Path="[tempFolder]" sap2010:WorkflowViewState.IdRef="CreateDirectory_1" />
    <umam:DownloadEmailAttachments ConnectionId="1dcdbe64-f5a8-42e5-9677-5e90d10e7ec1" ConflictResolution="Replace" DestinationPath="[tempFolder]" DisplayName="Download Answer PDF" Email="[in_AnswerMail]" ExcludeInlineAttachments="True" NewResult="[attachments]" SearchMode="UseSimple" UseConnectionService="True" sap2010:WorkflowViewState.IdRef="DownloadEmailAttachments_1" />
    <If Condition="[attachments Is Nothing OrElse attachments.Length = 0]" DisplayName="Is the PDF Missing?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Throw DisplayName="Throw No PDF in Answer" Exception="[New BusinessRuleException(&quot;Svaret från Socialstyrelsen saknar PDF. Kontrollera mejlet &quot; &amp; in_AnswerMail.Subject &amp; &quot; i hr.rekrytering@.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Then>
    </If>
    <ui:ReadPDFText DisplayName="Read Answer PDF" ResourceFile="[attachments(0)]" Range="All" Text="[pdfText]" sap2010:WorkflowViewState.IdRef="ReadPDFText_1" />
    <ui:Matches DisplayName="Find Diarienummer" FirstMatch="[dnr]" Input="[pdfText]" Pattern="(?&lt;=Diarienummer:\s*)\S+" IsBuilderTabModified="False" RegexOption="IgnoreCase, Compiled" sap2010:WorkflowViewState.IdRef="Matches_1" />
    <ui:Matches DisplayName="Find Licence Status" FirstMatch="[licenceStatus]" Input="[pdfText]" Pattern="(?&lt;=Status:\s*)\S.*" IsBuilderTabModified="False" RegexOption="IgnoreCase, Compiled" sap2010:WorkflowViewState.IdRef="Matches_2" />
    <ui:Matches DisplayName="Find Restrictions" FirstMatch="[restrictions]" Input="[pdfText]" Pattern="(?&lt;=Begränsningar:\s*)\S.*" IsBuilderTabModified="False" RegexOption="IgnoreCase, Compiled" sap2010:WorkflowViewState.IdRef="Matches_3" />
    <ui:Matches DisplayName="Find Licence Date" FirstMatch="[licenceDate]" Input="[pdfText]" Pattern="(?&lt;=Legitimationsdatum:\s*)\S+" IsBuilderTabModified="False" RegexOption="IgnoreCase, Compiled" sap2010:WorkflowViewState.IdRef="Matches_4" />
    <Assign x:TypeArguments="x:String" DisplayName="Clean Diarienummer" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[dnr]" Value="[If(String.IsNullOrWhiteSpace(dnr), &quot;-&quot;, dnr.Trim)]" />
    <Assign x:TypeArguments="x:String" DisplayName="Clean Licence Status" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[licenceStatus]" Value="[If(String.IsNullOrWhiteSpace(licenceStatus), &quot;&quot;, licenceStatus.Trim)]" />
    <Assign x:TypeArguments="x:String" DisplayName="Clean Restrictions" sap2010:WorkflowViewState.IdRef="Assign`1_4" To="[restrictions]" Value="[If(String.IsNullOrWhiteSpace(restrictions), &quot;&quot;, restrictions.Trim)]" />
    <Assign x:TypeArguments="x:String" DisplayName="Clean Licence Date" sap2010:WorkflowViewState.IdRef="Assign`1_5" To="[licenceDate]" Value="[If(String.IsNullOrWhiteSpace(licenceDate), &quot;-&quot;, licenceDate.Trim)]" />
    <If Condition="[licenceStatus = &quot;Giltig&quot; AndAlso restrictions = &quot;Inga&quot;]" DisplayName="Is the Licence Valid Without Restrictions?" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Sequence DisplayName="Clean Answer" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Assign x:TypeArguments="x:String" DisplayName="Status Done" sap2010:WorkflowViewState.IdRef="Assign`1_6" To="[checkStatus]" Value="Done" />
          <Assign x:TypeArguments="x:String" DisplayName="Build Done Result" sap2010:WorkflowViewState.IdRef="Assign`1_7" To="[checkResult]" Value="[&quot;Legitimerad &quot; &amp; in_Profession.ToLower &amp; &quot; sedan &quot; &amp; licenceDate &amp; &quot;. Giltig, inga begränsningar. Dnr &quot; &amp; dnr &amp; &quot;.&quot;]" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Finding for HR" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Assign x:TypeArguments="x:String" DisplayName="Status Needs Review" sap2010:WorkflowViewState.IdRef="Assign`1_8" To="[checkStatus]" Value="Needs review" />
          <If Condition="[pdfText.Contains(&quot;Personen finns inte i registret&quot;)]" DisplayName="Is the Person Missing in HOSP?" sap2010:WorkflowViewState.IdRef="If_3">
            <If.Then>
              <Assign x:TypeArguments="x:String" DisplayName="Build Not Found Result" sap2010:WorkflowViewState.IdRef="Assign`1_9" To="[checkResult]" Value="[&quot;Personen finns inte i HOSP-registret enligt Socialstyrelsen. Kontrollera personnummer och legitimation. Dnr &quot; &amp; dnr &amp; &quot;.&quot;]" />
            </If.Then>
            <If.Else>
              <Assign x:TypeArguments="x:String" DisplayName="Build Finding Result" sap2010:WorkflowViewState.IdRef="Assign`1_10" To="[checkResult]" Value="[&quot;HOSP: status &quot; &amp; licenceStatus &amp; &quot;, begränsningar: &quot; &amp; restrictions &amp; &quot;. Behöver granskas av HR. Dnr &quot; &amp; dnr &amp; &quot;.&quot;]" />
            </If.Else>
          </If>
        </Sequence>
      </If.Else>
    </If>
    <ui:LogMessage DisplayName="Log Decision" Level="Info" Message="[&quot;HOSP answer for check row &quot; &amp; in_CheckItemId &amp; &quot;: &quot; &amp; checkStatus &amp; &quot; (Dnr &quot; &amp; dnr &amp; &quot;).&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
    <ui:BuildDataTable DataTable="[dt_PdfMetadata]" sap2010:Annotation.AnnotationText="One row per library column: Field = column name, Value = value. The Hire lookup takes the New Hires item ID." DisplayName="Build PDF Metadata Table" sap2010:WorkflowViewState.IdRef="BuildDataTable_1" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;PdfMetadata&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;PdfMetadata&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;Field&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Value&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;&lt;/NewDataSet&gt;" />
    <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[New Object() {&quot;Hire&quot;, in_HireItemId}]" DataTable="[dt_PdfMetadata]" DisplayName="Add Hire Field" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
    <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[New Object() {&quot;CheckType&quot;, &quot;Legitimation&quot;}]" DataTable="[dt_PdfMetadata]" DisplayName="Add Check Type Field" sap2010:WorkflowViewState.IdRef="AddDataRow_3" />
    <umaf:UploadFilesConnections ConnectionId="6ca5372c-9b89-4f23-9741-3d8071f20af9" ConflictResolution="Replace" DisplayName="Save PDF in Authority Answers" FilesInputMode="Single" ItemSelectionMode="ItemUrl" Metadata="[dt_PdfMetadata]" SingleFileToUpload="[attachments(0)]" UseConnectionService="True" sap2010:WorkflowViewState.IdRef="UploadFilesConnections_1">
      <umaf:UploadFilesConnections.DriveItemArgument>
        <umafm:DriveItemArgument ItemSelectionMode="ItemUrl">
          <umafm:DriveItemArgument.ItemIdBackup>
            <usau:BackupSlot x:TypeArguments="umafe:EDriveItemMode" StoredValue="ItemUrl">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umafe:EDriveItemMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umafm:DriveItemArgument.ItemIdBackup>
          <umafm:DriveItemArgument.ManualEntryItemUrl>
            <InArgument x:TypeArguments="x:String">[in_Config("AnswersLibraryUrl").ToString]</InArgument>
          </umafm:DriveItemArgument.ManualEntryItemUrl>
        </umafm:DriveItemArgument>
      </umaf:UploadFilesConnections.DriveItemArgument>
    </umaf:UploadFilesConnections>
    <ui:BuildDataTable DataTable="[dt_NewValues]" DisplayName="Build New Values Table" sap2010:WorkflowViewState.IdRef="BuildDataTable_2" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;NewValues&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;NewValues&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;Status&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Result&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;CheckedBy&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;CheckedDate&quot; type=&quot;xs:dateTime&quot; minOccurs=&quot;0&quot; /&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;&lt;/NewDataSet&gt;" />
    <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[New Object() {checkStatus, checkResult, in_Config(&quot;RobotEmail&quot;).ToString, DateTime.Today}]" DataTable="[dt_NewValues]" DisplayName="Add Answer Values" sap2010:WorkflowViewState.IdRef="AddDataRow_2" />
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke UpdateCheckRow workflow" UnSafe="False" WorkflowFileName="Workflows\UpdateCheckRow.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument>
        <InArgument x:TypeArguments="x:String" x:Key="in_CheckItemId">[in_CheckItemId]</InArgument>
        <InArgument x:TypeArguments="sd:DataRow" x:Key="in_NewValues">[dt_NewValues.Rows(0)]</InArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <umam:MarkAsReadUnreadConnections ConnectionId="1dcdbe64-f5a8-42e5-9677-5e90d10e7ec1" DisplayName="Mark Answer Mail as Read" Email="[in_AnswerMail]" MarkAsReadUnread="Read" UseConnectionService="True" sap2010:WorkflowViewState.IdRef="MarkAsReadUnreadConnections_1" />
    <ui:DeleteFileX DisplayName="Delete Local PDF Copy" Path="[attachments(0).LocalPath]" sap2010:WorkflowViewState.IdRef="DeleteFileX_1" />
  </Sequence>
</Activity>
