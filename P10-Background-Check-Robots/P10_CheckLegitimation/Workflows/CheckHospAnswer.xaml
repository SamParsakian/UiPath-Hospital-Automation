  <Sequence DisplayName="Check HOSP Answer" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(umm:Office365Message)" Name="inboxMails" />
      <Variable x:TypeArguments="umm:Office365Message" Name="answerMail" />
    </Sequence.Variables>
    <umam:GetEmailListConnections ConnectionId="1dcdbe64-f5a8-42e5-9677-5e90d10e7ec1" DisplayName="Get HR Inbox Mails with Attachments" EmailList="[inboxMails]" IncludeAttachments="None" IncludeSubfolders="False" MarkAsRead="False" MaxResults="0" UnreadOnly="False" UseConnectionService="True" WithAttachmentsOnly="True" sap2010:WorkflowViewState.IdRef="GetEmailListConnections_1">
      <umam:GetEmailListConnections.FilterSelectionBackup>
        <usau:BackupSlot x:TypeArguments="umame:FilterMode" StoredValue="ConditionBuilder">
          <usau:BackupSlot.BackupValues>
            <scg:Dictionary x:TypeArguments="umame:FilterMode, scg:List(x:Object)" />
          </usau:BackupSlot.BackupValues>
        </usau:BackupSlot>
      </umam:GetEmailListConnections.FilterSelectionBackup>
      <umam:GetEmailListConnections.MailFolderArgument>
        <umamm:MailFolderArgument SelectionMode="EnterPath">
          <umamm:MailFolderArgument.Backup>
            <usau:BackupSlot x:TypeArguments="umame:ItemSelectionMode" StoredValue="EnterPath">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umame:ItemSelectionMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umamm:MailFolderArgument.Backup>
          <umamm:MailFolderArgument.ManualEntryFolder>
            <InArgument x:TypeArguments="x:String">["Inbox"]</InArgument>
          </umamm:MailFolderArgument.ManualEntryFolder>
        </umamm:MailFolderArgument>
      </umam:GetEmailListConnections.MailFolderArgument>
      <umam:GetEmailListConnections.MailboxArg>
        <umamm:MailboxArgument UseSharedMailbox="True">
          <umamm:MailboxArgument.Backup>
            <usau:BackupSlot x:TypeArguments="umame:MailboxSelectionMode" StoredValue="NoMailbox">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umame:MailboxSelectionMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umamm:MailboxArgument.Backup>
          <umamm:MailboxArgument.SharedMailbox>
            <InArgument x:TypeArguments="x:String">[in_Config("HrMailbox").ToString]</InArgument>
          </umamm:MailboxArgument.SharedMailbox>
        </umamm:MailboxArgument>
      </umam:GetEmailListConnections.MailboxArg>
    </umam:GetEmailListConnections>
    <ui:ForEach x:TypeArguments="umm:Office365Message" CurrentIndex="{x:Null}" DisplayName="For Each Inbox Mail" Values="[inboxMails]" sap2010:WorkflowViewState.IdRef="ForEach`1_1">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="umm:Office365Message">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="umm:Office365Message" Name="mail" />
          </ActivityAction.Argument>
          <If Condition="[mail.FromAddress.ToLower = in_Config(&quot;HospMailAddress&quot;).ToString.ToLower AndAlso mail.Subject.StartsWith(&quot;SV:&quot;) AndAlso mail.Subject.Contains(in_Personnummer)]" DisplayName="Is It the HOSP Answer for This Person?" sap2010:WorkflowViewState.IdRef="If_1">
            <If.Then>
              <Assign x:TypeArguments="umm:Office365Message" DisplayName="Keep the Answer Mail" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[answerMail]" Value="[mail]" />
            </If.Then>
          </If>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <If Condition="[answerMail Is Nothing]" DisplayName="Has Socialstyrelsen Answered?" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Sequence DisplayName="No Answer Yet" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:LogMessage DisplayName="Log No Answer Yet" Level="Info" Message="[&quot;No HOSP answer yet for check row &quot; &amp; in_CheckItemId &amp; &quot;. The row stays Waiting for answer.&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
        </Sequence>
      </If.Then>
      <If.Else>
        <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" ContinueOnError="{x:Null}" DisplayName="Invoke HandleHospAnswer workflow" UnSafe="False" WorkflowFileName="Workflows\HandleHospAnswer.xaml" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2">
          <ui:InvokeWorkflowFile.Arguments>
            <InArgument x:TypeArguments="scg:Dictionary(x:String, x:Object)" x:Key="in_Config">[in_Config]</InArgument>
            <InArgument x:TypeArguments="umm:Office365Message" x:Key="in_AnswerMail">[answerMail]</InArgument>
            <InArgument x:TypeArguments="x:String" x:Key="in_CheckItemId">[in_CheckItemId]</InArgument>
            <InArgument x:TypeArguments="x:String" x:Key="in_HireItemId">[in_HireItemId]</InArgument>
            <InArgument x:TypeArguments="x:String" x:Key="in_Profession">[in_Profession]</InArgument>
          </ui:InvokeWorkflowFile.Arguments>
        </ui:InvokeWorkflowFile>
      </If.Else>
    </If>
  </Sequence>
</Activity>
