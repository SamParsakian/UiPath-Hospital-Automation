    <x:Property sap2010:Annotation.AnnotationText="The New Hires row of the hire." Name="in_HireRow" Type="InArgument(sd:DataRow)" />
    <x:Property sap2010:Annotation.AnnotationText="True if a check failed; False if all required checks are Done." Name="in_Failed" Type="InArgument(x:Boolean)" />
    <x:Property sap2010:Annotation.AnnotationText="One line per check with its result." Name="in_ResultLines" Type="InArgument(x:String)" />
  </x:Members>
