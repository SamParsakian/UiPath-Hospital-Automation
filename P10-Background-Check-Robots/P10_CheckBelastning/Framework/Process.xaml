          <If Condition="[String.IsNullOrWhiteSpace(personnummer) OrElse String.IsNullOrWhiteSpace(hireName)]" DisplayName="Is Name or Personnummer Missing?" sap2010:WorkflowViewState.IdRef="If_1">
