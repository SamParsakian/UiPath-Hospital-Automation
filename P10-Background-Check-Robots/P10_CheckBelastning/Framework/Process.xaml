            </umas:GetSingleSharepointListItemConnections.ListArgument>
          </umas:GetSingleSharepointListItemConnections>
          <Assign x:TypeArguments="x:String" DisplayName="Get Check Status" sap2010:WorkflowViewState.IdRef="Assign`1_6" To="[checkStatus]" Value="[checkRow(&quot;Status&quot;).ToString]" />
