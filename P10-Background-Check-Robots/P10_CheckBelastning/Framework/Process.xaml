            </If.Then>
          </If>
          <umas:GetSingleSharepointListItemConnections x:TypeArguments="sd:DataRow" ConnectionId="6ca5372c-9b89-4f23-9741-3d8071f20af9" DisplayName="Get Check Row" ItemId="[checkItemId]" ItemSelectionMode="Manually" Result="[checkRow]" ColumnsToRetrieveByName="[New String() {&quot;ID&quot;, &quot;Title&quot;, &quot;CheckType&quot;, &quot;Status&quot;}]" WorkById="True" sap2010:WorkflowViewState.IdRef="GetSingleSharepointListItemConnections_1">
