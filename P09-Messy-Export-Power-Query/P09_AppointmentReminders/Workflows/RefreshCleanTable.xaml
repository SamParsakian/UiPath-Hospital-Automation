  <Sequence DisplayName="Refresh the Clean Table" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <ui:CopyFile ContinueOnError="{x:Null}" DestinationResource="{x:Null}" PathResource="{x:Null}" Destination="[in_WorkFile]" DisplayName="Copy the Power Query File" sap2010:WorkflowViewState.IdRef="CopyFile_1" Overwrite="True" Path="[in_TemplateFile]" />
    <ueab:ExcelProcessScopeX DisplayAlerts="{x:Null}" ExistingProcessAction="{x:Null}" FileConflictResolution="{x:Null}" LaunchMethod="{x:Null}" LaunchTimeout="{x:Null}" MacroSettings="{x:Null}" ProcessMode="{x:Null}" ShowExcelWindow="{x:Null}" DisplayName="Start Excel" sap2010:WorkflowViewState.IdRef="ExcelProcessScopeX_1">
      <ueab:ExcelProcessScopeX.Body>
        <ActivityAction x:TypeArguments="ui:IExcelProcess">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="ui:IExcelProcess" Name="ExcelProcessScopeTag" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ueab:ExcelApplicationCard DisplayName="Use the Power Query File" sap2010:WorkflowViewState.IdRef="ExcelApplicationCard_1" ResizeWindow="None" WorkbookPath="[in_WorkFile]" CreateNewFile="False">
              <ueab:ExcelApplicationCard.Body>
                <ActivityAction x:TypeArguments="ue:IWorkbookQuickHandle">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="ue:IWorkbookQuickHandle" Name="CleanFile" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_3">
                    <ueab:WriteCellX DisplayName="Write the Export File Path" sap2010:WorkflowViewState.IdRef="WriteCellX_1" Cell="[CleanFile.Sheet(&quot;Inställningar&quot;).Cell(&quot;B1&quot;)]" Value="[in_ExportFile]" />
                    <ueab:RefreshDataConnectionsX DisplayName="Refresh Power Query" sap2010:WorkflowViewState.IdRef="RefreshDataConnectionsX_1" Workbook="[CleanFile]" />
                    <ueab:ReadRangeX DisplayName="Read the Clean Table" sap2010:WorkflowViewState.IdRef="ReadRangeX_1" Range="[CleanFile.Table(&quot;CleanAppointments&quot;)]" SaveTo="[out_dt_Appointments]" />
                  </Sequence>
                </ActivityAction>
              </ueab:ExcelApplicationCard.Body>
            </ueab:ExcelApplicationCard>
          </Sequence>
        </ActivityAction>
      </ueab:ExcelProcessScopeX.Body>
    </ueab:ExcelProcessScopeX>
    <If Condition="[out_dt_Appointments.Rows.Count = 0 OrElse String.IsNullOrEmpty(out_dt_Appointments.Rows(0)(&quot;Patient-ID&quot;).ToString())]" DisplayName="Is the Clean Table Empty?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Throw DisplayName="Stop - Power Query Gave No Appointments" sap2010:WorkflowViewState.IdRef="Throw_1" Exception="[New Exception(&quot;Power Query gave no appointments for &quot; &amp; in_ExportFile &amp; &quot;. Open &quot; &amp; in_WorkFile &amp; &quot; and select Data &gt; Refresh All to see the error.&quot;)]" />
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Clean Rows" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Appointments in the clean table: {out_dt_Appointments.Rows.Count}&quot;]" />
  </Sequence>
</Activity>
