  <Sequence DisplayName="Make the Reminder List" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dt_PerClinic" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_NoPhone" />
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:Int32)" Name="clinicCounts" Default="[New Dictionary(Of String, Integer)]" />
      <Variable x:TypeArguments="x:Int32" Name="bookedCount" Default="0" />
      <Variable x:TypeArguments="x:Int32" Name="cancelledCount" Default="0" />
      <Variable x:TypeArguments="x:Boolean" Name="reportExists" />
    </Sequence.Variables>
    <Assign x:TypeArguments="sd:DataTable" DisplayName="Create Table Per Clinic" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[dt_PerClinic]" Value="[New DataTable()]" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Mottagning" DataTable="[dt_PerClinic]" DisplayName="Add Column Mottagning" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_1" />
    <ui:AddDataColumn x:TypeArguments="x:Int32" ColumnName="Antal bokningar" DataTable="[dt_PerClinic]" DisplayName="Add Column Antal bokningar" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_2" />
    <Assign x:TypeArguments="sd:DataTable" DisplayName="Create Table Without Phone" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[dt_NoPhone]" Value="[New DataTable()]" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Mottagning" DataTable="[dt_NoPhone]" DisplayName="Add Column Mottagning to List" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_3" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Tid" DataTable="[dt_NoPhone]" DisplayName="Add Column Tid" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_4" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Patient-ID" DataTable="[dt_NoPhone]" DisplayName="Add Column Patient-ID" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_5" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Namn" DataTable="[dt_NoPhone]" DisplayName="Add Column Namn" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_6" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Personnummer" DataTable="[dt_NoPhone]" DisplayName="Add Column Personnummer" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_7" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Vårdgivare" DataTable="[dt_NoPhone]" DisplayName="Add Column Vårdgivare" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_8" />
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[in_dt_Appointments]" DisplayName="For Each Appointment" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:String" Name="clinicName" />
            </Sequence.Variables>
            <Assign x:TypeArguments="x:String" DisplayName="Get Clinic" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[clinicName]" Value="[CurrentRow(&quot;Mottagning&quot;).ToString()]" />
            <If Condition="[CurrentRow(&quot;Status&quot;).ToString() = &quot;Bokad&quot;]" DisplayName="Is the Appointment Booked?" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <Sequence DisplayName="Booked" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <Assign x:TypeArguments="x:Int32" DisplayName="Count Booked" sap2010:WorkflowViewState.IdRef="Assign`1_4" To="[bookedCount]" Value="[bookedCount + 1]" />
                  <If Condition="[Not clinicCounts.ContainsKey(clinicName)]" DisplayName="New Clinic?" sap2010:WorkflowViewState.IdRef="If_2">
                    <If.Then>
                      <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_4">
                        <Assign x:TypeArguments="x:Int32" DisplayName="Start Clinic Count" sap2010:WorkflowViewState.IdRef="Assign`1_5" To="[clinicCounts(clinicName)]" Value="0" />
                      </Sequence>
                    </If.Then>
                  </If>
                  <Assign x:TypeArguments="x:Int32" DisplayName="Count Clinic" sap2010:WorkflowViewState.IdRef="Assign`1_6" To="[clinicCounts(clinicName)]" Value="[clinicCounts(clinicName) + 1]" />
                  <If Condition="[String.IsNullOrEmpty(CurrentRow(&quot;Telefon&quot;).ToString())]" DisplayName="No Phone Number?" sap2010:WorkflowViewState.IdRef="If_3">
                    <If.Then>
                      <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_5">
                        <ui:AddDataRow DataRow="{x:Null}" DataTable="[dt_NoPhone]" DisplayName="Add to List Without Phone" sap2010:WorkflowViewState.IdRef="AddDataRow_1">
                          <ui:AddDataRow.ArrayRow>
                            <InArgument x:TypeArguments="s:Object[]">[New Object() {clinicName, CDate(CurrentRow("Tid")).ToString("HH:mm"), CurrentRow("Patient-ID").ToString(), CurrentRow("Namn").ToString(), CurrentRow("Personnummer").ToString(), CurrentRow("Vårdgivare").ToString()}]</InArgument>
                          </ui:AddDataRow.ArrayRow>
                        </ui:AddDataRow>
                      </Sequence>
                    </If.Then>
                  </If>
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence DisplayName="Cancelled" sap2010:WorkflowViewState.IdRef="Sequence_6">
                  <Assign x:TypeArguments="x:Int32" DisplayName="Count Cancelled" sap2010:WorkflowViewState.IdRef="Assign`1_7" To="[cancelledCount]" Value="[cancelledCount + 1]" />
                </Sequence>
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Clinic" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[clinicCounts.Keys]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="clinic" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_7">
            <ui:AddDataRow DataRow="{x:Null}" DataTable="[dt_PerClinic]" DisplayName="Add Clinic Count" sap2010:WorkflowViewState.IdRef="AddDataRow_2">
              <ui:AddDataRow.ArrayRow>
                <InArgument x:TypeArguments="s:Object[]">[New Object() {clinic, clinicCounts(clinic)}]</InArgument>
              </ui:AddDataRow.ArrayRow>
            </ui:AddDataRow>
            <ui:LogMessage DisplayName="Log Clinic Count" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;{clinic}: {clinicCounts(clinic)} appointments&quot;]" />
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage DisplayName="Log Totals" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[$&quot;Booked: {bookedCount}, cancelled: {cancelledCount}, patients without phone: {dt_NoPhone.Rows.Count}&quot;]" />
    <ui:PathExists DisplayName="Check Old Reminder List" Exists="[reportExists]" sap2010:WorkflowViewState.IdRef="PathExists_1" Path="[in_ReportFile]" PathType="File" />
    <If Condition="[reportExists]" DisplayName="Old List Exists?" sap2010:WorkflowViewState.IdRef="If_4">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_8">
          <ui:DeleteFileX DisplayName="Delete Old Reminder List" sap2010:WorkflowViewState.IdRef="DeleteFileX_1" Path="[in_ReportFile]" />
        </Sequence>
      </If.Then>
    </If>
    <ui:WriteRange AddHeaders="True" DataTable="[dt_PerClinic]" DisplayName="Write Sheet Per mottagning" sap2010:WorkflowViewState.IdRef="WriteRange_1" SheetName="Per mottagning" StartingCell="A1" WorkbookPath="[in_ReportFile]" />
    <ui:WriteRange AddHeaders="True" DataTable="[dt_NoPhone]" DisplayName="Write Sheet Utan telefon" sap2010:WorkflowViewState.IdRef="WriteRange_2" SheetName="Utan telefon" StartingCell="A1" WorkbookPath="[in_ReportFile]" />
  </Sequence>
</Activity>
