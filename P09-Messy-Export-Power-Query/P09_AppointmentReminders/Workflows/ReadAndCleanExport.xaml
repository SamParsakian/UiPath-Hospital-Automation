<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_ReadAndCleanExport" VisualBasic.Settings="{x:Null}" sap2010:WorkflowViewState.IdRef="ActivityBuilder_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property Name="in_ExportFile" Type="InArgument(x:String)" />
    <x:Property Name="out_dt_Appointments" Type="OutArgument(sd:DataTable)" />
  </x:Members>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Windows.Markup</x:String>
      <x:String>GlobalVariablesNamespace</x:String>
      <x:String>GlobalConstantsNamespace</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>System.Collections</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Read and Clean the Export" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Export" />
      <Variable x:TypeArguments="s:String[]" Name="monthNames" Default="[{&quot;jan&quot;, &quot;feb&quot;, &quot;mar&quot;, &quot;apr&quot;, &quot;maj&quot;, &quot;jun&quot;, &quot;jul&quot;, &quot;aug&quot;, &quot;sep&quot;, &quot;okt&quot;, &quot;nov&quot;, &quot;dec&quot;}]" />
    </Sequence.Variables>
    <ui:ReadRange AddHeaders="False" DataTable="[dt_Export]" DisplayName="Read the Whole Export Sheet" sap2010:WorkflowViewState.IdRef="ReadRange_1" Range="" SheetName="Bokningar" WorkbookPath="[in_ExportFile]" />
    <ui:LogMessage DisplayName="Log Rows Read" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Rows read from the export: {dt_Export.Rows.Count}&quot;]" />
    <Assign x:TypeArguments="sd:DataTable" DisplayName="Create Clean Table" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[out_dt_Appointments]" Value="[New DataTable()]" />
    <ui:AddDataColumn x:TypeArguments="s:DateTime" ColumnName="Tid" DataTable="[out_dt_Appointments]" DisplayName="Add Column Tid" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_1" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Mottagning" DataTable="[out_dt_Appointments]" DisplayName="Add Column Mottagning" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_2" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Status" DataTable="[out_dt_Appointments]" DisplayName="Add Column Status" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_3" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Patient-ID" DataTable="[out_dt_Appointments]" DisplayName="Add Column Patient-ID" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_4" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Namn" DataTable="[out_dt_Appointments]" DisplayName="Add Column Namn" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_5" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Personnummer" DataTable="[out_dt_Appointments]" DisplayName="Add Column Personnummer" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_6" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Telefon" DataTable="[out_dt_Appointments]" DisplayName="Add Column Telefon" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_7" />
    <ui:AddDataColumn x:TypeArguments="x:String" ColumnName="Vårdgivare" DataTable="[out_dt_Appointments]" DisplayName="Add Column Vårdgivare" sap2010:WorkflowViewState.IdRef="AddDataColumn`1_8" />
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[dt_Export]" DisplayName="For Each Row in the Export" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:String" Name="timeText" />
              <Variable x:TypeArguments="s:String[]" Name="timeParts" />
              <Variable x:TypeArguments="s:DateTime" Name="appointmentTime" />
              <Variable x:TypeArguments="x:String" Name="clinicName" />
              <Variable x:TypeArguments="x:String" Name="phoneNumber" />
            </Sequence.Variables>
            <Assign x:TypeArguments="x:String" DisplayName="Get Time Text (Column A)" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[timeText]" Value="[CurrentRow(0).ToString().Trim()]" />
            <If Condition="[timeText.Contains(&quot; kl &quot;)]" DisplayName="Is It a Booking Row?" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <Sequence DisplayName="Clean the Booking Row" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <Assign x:TypeArguments="s:String[]" DisplayName="Split the Time Text" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[timeParts]" Value="[timeText.Split(&quot; &quot;c)]" />
                  <Assign x:TypeArguments="s:DateTime" DisplayName="Make a Real Date and Time" sap2010:WorkflowViewState.IdRef="Assign`1_4" To="[appointmentTime]" Value="[New DateTime(CInt(timeParts(2)), Array.IndexOf(monthNames, timeParts(1)) + 1, CInt(timeParts(0))).Add(TimeSpan.Parse(timeParts(4)))]" />
                  <Assign x:TypeArguments="x:String" DisplayName="Get Clinic (Column B)" sap2010:WorkflowViewState.IdRef="Assign`1_5" To="[clinicName]" Value="[CurrentRow(1).ToString().Trim().ToLower()]" />
                  <Switch x:TypeArguments="x:String" DisplayName="Write Short Clinic Names in Full" Expression="[clinicName]" sap2010:WorkflowViewState.IdRef="Switch`1_1">
                    <Sequence x:Key="kard." DisplayName="kard." sap2010:WorkflowViewState.IdRef="Sequence_4">
                      <Assign x:TypeArguments="x:String" DisplayName="Kardiologi" sap2010:WorkflowViewState.IdRef="Assign`1_6" To="[clinicName]" Value="kardiologi" />
                    </Sequence>
                    <Sequence x:Key="ort." DisplayName="ort." sap2010:WorkflowViewState.IdRef="Sequence_5">
                      <Assign x:TypeArguments="x:String" DisplayName="Ortopedi" sap2010:WorkflowViewState.IdRef="Assign`1_7" To="[clinicName]" Value="ortopedi" />
                    </Sequence>
                    <Sequence x:Key="med." DisplayName="med." sap2010:WorkflowViewState.IdRef="Sequence_6">
                      <Assign x:TypeArguments="x:String" DisplayName="Medicin" sap2010:WorkflowViewState.IdRef="Assign`1_8" To="[clinicName]" Value="medicin" />
                    </Sequence>
                    <Sequence x:Key="neuro" DisplayName="neuro" sap2010:WorkflowViewState.IdRef="Sequence_7">
                      <Assign x:TypeArguments="x:String" DisplayName="Neurologi" sap2010:WorkflowViewState.IdRef="Assign`1_9" To="[clinicName]" Value="neurologi" />
                    </Sequence>
                    <Sequence x:Key="gyn." DisplayName="gyn." sap2010:WorkflowViewState.IdRef="Sequence_8">
                      <Assign x:TypeArguments="x:String" DisplayName="Gynekologi" sap2010:WorkflowViewState.IdRef="Assign`1_10" To="[clinicName]" Value="gynekologi" />
                    </Sequence>
                    <Sequence x:Key="barn/ungdom" DisplayName="barn/ungdom" sap2010:WorkflowViewState.IdRef="Sequence_9">
                      <Assign x:TypeArguments="x:String" DisplayName="Barn och ungdom" sap2010:WorkflowViewState.IdRef="Assign`1_11" To="[clinicName]" Value="barn och ungdom" />
                    </Sequence>
                  </Switch>
                  <Assign x:TypeArguments="x:String" DisplayName="Capital First Letter" sap2010:WorkflowViewState.IdRef="Assign`1_12" To="[clinicName]" Value="[clinicName.Substring(0, 1).ToUpper() &amp; clinicName.Substring(1)]" />
                  <Assign x:TypeArguments="x:String" DisplayName="Get Phone (Column G)" sap2010:WorkflowViewState.IdRef="Assign`1_13" To="[phoneNumber]" Value="[CurrentRow(6).ToString().Trim()]" />
                  <If Condition="[phoneNumber = &quot;-&quot; Or phoneNumber.ToLower() = &quot;saknas&quot;]" DisplayName="Phone Written as - or saknas?" sap2010:WorkflowViewState.IdRef="If_2">
                    <If.Then>
                      <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_10">
                        <Assign x:TypeArguments="x:String" DisplayName="No Phone Number" sap2010:WorkflowViewState.IdRef="Assign`1_14" To="[phoneNumber]" Value="[String.Empty]" />
                      </Sequence>
                    </If.Then>
                  </If>
                  <ui:AddDataRow DataRow="{x:Null}" DataTable="[out_dt_Appointments]" DisplayName="Add Clean Row" sap2010:WorkflowViewState.IdRef="AddDataRow_1">
                    <ui:AddDataRow.ArrayRow>
                      <InArgument x:TypeArguments="s:Object[]">[New Object() {appointmentTime, clinicName, CurrentRow(2).ToString().Trim(), CurrentRow(3).ToString().Trim(), CurrentRow(4).ToString().Trim(), CurrentRow(5).ToString().Trim(), phoneNumber, CurrentRow(7).ToString().Trim()}]</InArgument>
                    </ui:AddDataRow.ArrayRow>
                  </ui:AddDataRow>
                </Sequence>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:LogMessage DisplayName="Log Clean Rows" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[$&quot;Booking rows after the cleanup: {out_dt_Appointments.Rows.Count}&quot;]" />
  </Sequence>
</Activity>
