<Activity mc:Ignorable="sap sap2010" x:Class="Workflows_AppendReportLine" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <x:Members>
    <x:Property sap2010:Annotation.AnnotationText="Fixed folder of the daily report, outside the package folder of the robot" Name="in_ReportFolder" Type="InArgument(x:String)" />
    <x:Property Name="in_TransferId" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="1 for the first attempt, 2 and 3 for the retries of the queue item" Name="in_Attempt" Type="InArgument(x:Int32)" />
    <x:Property sap2010:Annotation.AnnotationText="Status of the transfer when the robot opened it" Name="in_StatusBefore" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Success, Business exception or System exception" Name="in_Result" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Outcome for the coordinator, for example Needs manual data correction" Name="in_Outcome" Type="InArgument(x:String)" />
    <x:Property sap2010:Annotation.AnnotationText="Error text or short explanation" Name="in_Detail" Type="InArgument(x:String)" />
  </x:Members>
  <sap2010:WorkflowViewState.IdRef>ActivityBuilder_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>System</x:String>
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence sap2010:Annotation.AnnotationText="Adds one line per attempt to the daily report transfer_report_&lt;date&gt;.csv in the report folder. The last line of a transfer is its final outcome." DisplayName="Append Report Line" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="reportPath" />
    </Sequence.Variables>
    <Assign DisplayName="Report File Path" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[reportPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Path.Combine(in_ReportFolder, "transfer_report_" &amp; Now.ToString("yyyy-MM-dd") &amp; ".csv")]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:CreateDirectory DisplayName="Create Report Folder" Path="[in_ReportFolder]" sap2010:WorkflowViewState.IdRef="CreateDirectory_1" />
    <If Condition="[Not File.Exists(reportPath)]" DisplayName="Is It a New Report?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Start a New Report" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <ui:LogMessage DisplayName="Log the Report Path" Level="Info" Message="[&quot;New daily report: &quot; &amp; reportPath]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />
          <ui:AppendLine DisplayName="Write the Header" Encoding="utf-8" FileName="[reportPath]" sap2010:WorkflowViewState.IdRef="AppendLine_1" Text="time;transfer_id;attempt;status_before;result;outcome;detail" />
        </Sequence>
      </If.Then>
    </If>
    <ui:AppendLine DisplayName="Write the Line" Encoding="utf-8" FileName="[reportPath]" sap2010:WorkflowViewState.IdRef="AppendLine_2" Text="[String.Join(&quot;;&quot;, {Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;), in_TransferId, in_Attempt.ToString, in_StatusBefore, in_Result, in_Outcome, If(in_Detail, &quot;&quot;).Replace(&quot;;&quot;, &quot;,&quot;).Replace(vbCr, &quot; &quot;).Replace(vbLf, &quot; &quot;)})]" />
  </Sequence>
</Activity>
