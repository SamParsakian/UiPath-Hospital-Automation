    <x:Property sap2010:Annotation.AnnotationText="One string array per transfer row: 0 ID, 1 Ärende, 2 Patient, 3 Typ, 4 Till, 5 Status, 6 Begärd, 7 Felmeddelande" Name="out_Rows" Type="OutArgument(scg:List(s:String[]))" />
  </x:Members>
