  <Sequence sap2010:Annotation.AnnotationText="Presses the button of one transfer row (Utför or Försök igen) and waits until Journalsamordning has answered and shown the transfer list again." DisplayName="Run Transfer" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="transferId" />
      <Variable x:TypeArguments="x:String" Name="currentUrl">
        <Variable.Default>
          <Literal x:TypeArguments="x:String" Value="" />
        </Variable.Default>
      </Variable>
      <Variable x:TypeArguments="x:Int32" Default="0" Name="checks" />
    </Sequence.Variables>
    <Assign DisplayName="Transfer ID for the Row Selector" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[transferId]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[in_TransferId.Trim()]</InArgument>
      </Assign.Value>
    </Assign>
    <uix:NApplicationCard AttachMode="ByInstance" CloseMode="Never" DisplayName="Use Browser Journalsamordning" HealingAgentBehavior="Job" sap2010:WorkflowViewState.IdRef="NApplicationCard_1" OpenMode="Never" ScopeGuid="88038961-9f36-4d83-afe7-181dedf66372" Version="V2">
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <uix:NClick ActivateBefore="True" ClickType="Single" DisplayName="Click the Transfer Button" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NClick_1" KeyModifiers="None" MouseButton="Left" Version="V5">
              <uix:NClick.Target>
                <uix:TargetAnchorable ContentHash="Y9IkuRbTF0qafar3UOTfrw" DesignTimeRectangle="1954, 808, 107, 32" ElementType="Button" ElementVisibilityArgument="Interactive" FullSelectorArgument="[string.Format(&quot;&lt;webctrl colName='Åtgärder' parentid='transfer-table' rowName='{0}' tag='BUTTON' /&gt;&quot;, transferId)]" Guid="c0d13240-bbbd-44d7-be9b-0fa27e09ad86" InformativeScreenshot="fb6d376144a8280aebe062e0ec647bdc.jpg" Reference="yb9ZbGjCXkShps6ECnrLFw/6ECyPf50wkq3uVgK-TQ6Kg" ScopeSelectorArgument="&lt;html app='chrome.exe' url='http://100.99.72.90:8081/*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
              </uix:NClick.Target>
            </uix:NClick>
            <DoWhile sap2010:Annotation.AnnotationText="The page sends the transfer to the target system and then opens the transfer list without a filter. The target can take a few seconds, so the URL is checked every half second (at most 30 seconds)." DisplayName="Wait Until the Page Has Answered" sap2010:WorkflowViewState.IdRef="DoWhile_1" Condition="[currentUrl.Contains(&quot;q=&quot;) AndAlso checks &lt; 60]">
              <Sequence DisplayName="Check the Page Address" sap2010:WorkflowViewState.IdRef="Sequence_3">
                <Delay DisplayName="Wait Half a Second" Duration="00:00:00.5000000" sap2010:WorkflowViewState.IdRef="Delay_1" />
                <uix:NGetUrl CurrentUrl="[currentUrl]" DisplayName="Get the Page Address" sap2010:WorkflowViewState.IdRef="NGetUrl_1" Version="V5" />
                <Assign DisplayName="Count the Check" sap2010:WorkflowViewState.IdRef="Assign_2">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Int32">[checks]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Int32">[checks + 1]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </DoWhile>
          </Sequence>
        </ActivityAction>
      </uix:NApplicationCard.Body>
      <uix:NApplicationCard.OCREngine>
        <ActivityFunc x:TypeArguments="sd:Image, scg:IEnumerable(scg:KeyValuePair(sd1:Rectangle, x:String))">
          <ActivityFunc.Argument>
            <DelegateInArgument x:TypeArguments="sd:Image" Name="Image" />
          </ActivityFunc.Argument>
        </ActivityFunc>
      </uix:NApplicationCard.OCREngine>
      <uix:NApplicationCard.TargetApp>
        <uix:TargetApp Area="-12, -12, 2584, 1464" BrowserType="Chrome" ContentHash="4q3VC1gtBEeKnlNowqZOaA" InformativeScreenshot="2917ec3a41b372b0aa566cd11230d3bf.jpg" Reference="yb9ZbGjCXkShps6ECnrLFw/-84Ymno3qE-nDByjSFGnyw" Selector="&lt;html app='chrome.exe' url='http://100.99.72.90:8081/*' /&gt;" Url="http://100.99.72.90:8081/login" Version="V3" />
      </uix:NApplicationCard.TargetApp>
    </uix:NApplicationCard>
    <If Condition="[currentUrl.Contains(&quot;q=&quot;)]" DisplayName="Did the Page Not Answer?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Throw DisplayName="Throw System Exception (No Answer)" Exception="[New Exception(&quot;Journalsamordning did not answer after the transfer button was pressed for &quot; &amp; transferId &amp; &quot;.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
