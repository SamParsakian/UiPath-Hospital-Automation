  <Sequence DisplayName="Test Get Finance Data" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="config" />
      <Variable x:TypeArguments="sd:DataTable" Name="suppliers" />
      <Variable x:TypeArguments="sd:DataTable" Name="invoices" />
      <Variable x:TypeArguments="x:String" Name="inactiveSupplier" />
      <Variable x:TypeArguments="x:String" Name="paidInvoice" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke Read Config" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows\ReadConfig.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="out_Config">[config]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke Get Finance Data" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" UnSafe="False" WorkflowFileName="Workflows\GetFinanceData.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <InArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="in_Config">[config]</InArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Suppliers">[suppliers]</OutArgument>
        <OutArgument x:TypeArguments="sd:DataTable" x:Key="out_Invoices">[invoices]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <Assign x:TypeArguments="x:String" DisplayName="Find Status Of SUP-015" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[inactiveSupplier]" Value="[suppliers.Select(&quot;SupplierRef = 'SUP-015'&quot;)(0)(&quot;Status&quot;).ToString()]" />
    <Assign x:TypeArguments="x:String" DisplayName="Find Status Of INV-00011" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[paidInvoice]" Value="[invoices.Select(&quot;InvoiceRef = 'INV-00011'&quot;)(0)(&quot;Status&quot;).ToString()]" />
    <If Condition="[suppliers.Rows.Count = 15 AndAlso invoices.Rows.Count = 73 AndAlso inactiveSupplier = &quot;Inaktiv&quot; AndAlso paidInvoice = &quot;Betald&quot;]" DisplayName="Check Expected Values" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <ui:LogMessage DisplayName="Log Passed" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;PASSED: {suppliers.Rows.Count} suppliers, {invoices.Rows.Count} invoices, SUP-015 is {inactiveSupplier}, INV-00011 is {paidInvoice}&quot;]" />
      </If.Then>
      <If.Else>
        <Throw DisplayName="Throw Test Failed" Exception="[New Exception($&quot;FAILED: {suppliers.Rows.Count} suppliers, {invoices.Rows.Count} invoices, SUP-015 is {inactiveSupplier}, INV-00011 is {paidInvoice}&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Else>
    </If>
