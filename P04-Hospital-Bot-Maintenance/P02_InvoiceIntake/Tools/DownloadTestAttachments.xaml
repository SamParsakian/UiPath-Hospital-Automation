  <Sequence DisplayName="Download Test Attachments" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="expectedResults" />
      <Variable x:TypeArguments="scg:List(umm:Office365Message)" Name="inboxEmails" />
      <Variable x:TypeArguments="x:Int32" Name="savedEmails" Default="0" />
    </Sequence.Variables>
    <ui:ReadCsvFile DataTable="[expectedResults]" Delimitator="Semicolon" DelimitatorForViewModel="Semicolon" DisplayName="Read Expected Results" FilePath="[Path.Combine(Environment.CurrentDirectory, &quot;TestData&quot;, &quot;expected_results.csv&quot;)]" IncludeColumnNames="True" />
    <umam:GetEmailListConnections ConnectionId="1c702018-5e37-436e-8ec9-9ba68419b88b" DisplayName="Get Inbox Emails" EmailList="[inboxEmails]" IncludeAttachments="None" IncludeSubfolders="False" MarkAsRead="False" MaxResults="0" UnreadOnly="False" UseConnectionService="True" WithAttachmentsOnly="False">
      <umam:GetEmailListConnections.FilterSelectionBackup>
        <usau:BackupSlot x:TypeArguments="umame:FilterMode" StoredValue="ConditionBuilder">
          <usau:BackupSlot.BackupValues>
            <scg:Dictionary x:TypeArguments="umame:FilterMode, scg:List(x:Object)" />
          </usau:BackupSlot.BackupValues>
        </usau:BackupSlot>
      </umam:GetEmailListConnections.FilterSelectionBackup>
      <umam:GetEmailListConnections.MailFolderArgument>
        <umamm:MailFolderArgument SelectionMode="EnterPath">
          <umamm:MailFolderArgument.Backup>
            <usau:BackupSlot x:TypeArguments="umame:ItemSelectionMode" StoredValue="EnterPath">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umame:ItemSelectionMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umamm:MailFolderArgument.Backup>
          <umamm:MailFolderArgument.ManualEntryFolder>
            <InArgument x:TypeArguments="x:String">["Inbox"]</InArgument>
          </umamm:MailFolderArgument.ManualEntryFolder>
        </umamm:MailFolderArgument>
      </umam:GetEmailListConnections.MailFolderArgument>
      <umam:GetEmailListConnections.MailboxArg>
        <umamm:MailboxArgument UseSharedMailbox="True">
          <umamm:MailboxArgument.Backup>
            <usau:BackupSlot x:TypeArguments="umame:MailboxSelectionMode" StoredValue="NoMailbox">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umame:MailboxSelectionMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umamm:MailboxArgument.Backup>
          <umamm:MailboxArgument.SharedMailbox>
            <InArgument x:TypeArguments="x:String">["fakturor@stockholmdemohospital.onmicrosoft.com"]</InArgument>
          </umamm:MailboxArgument.SharedMailbox>
        </umamm:MailboxArgument>
      </umam:GetEmailListConnections.MailboxArg>
    </umam:GetEmailListConnections>
    <ui:ForEach x:TypeArguments="umm:Office365Message" DisplayName="For Each Email">
      <ui:ForEach.Values>
        <InArgument x:TypeArguments="sc:IEnumerable">
          <VisualBasicValue x:TypeArguments="sc:IEnumerable" ExpressionText="inboxEmails" />
        </InArgument>
      </ui:ForEach.Values>
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="umm:Office365Message">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="umm:Office365Message" Name="email" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:String" Name="scenarioId" />
              <Variable x:TypeArguments="x:String" Name="scenarioFolder" />
            </Sequence.Variables>
            <Assign x:TypeArguments="x:String" DisplayName="Find Scenario ID">
              <Assign.To>
                <OutArgument x:TypeArguments="x:String">
                  <VisualBasicReference x:TypeArguments="x:String" ExpressionText="scenarioId" />
                </OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:String">
                  <VisualBasicValue x:TypeArguments="x:String" ExpressionText="expectedResults.AsEnumerable().Where(Function(r) r(&quot;InternetMessageId&quot;).ToString() = email.InternetMessageId).Select(Function(r) r(&quot;ScenarioId&quot;).ToString()).FirstOrDefault()" />
                </InArgument>
              </Assign.Value>
            </Assign>
            <If DisplayName="Known Email With Attachments?">
              <If.Condition>
                <InArgument x:TypeArguments="x:Boolean">
                  <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="scenarioId IsNot Nothing AndAlso email.StandardAttachmentCount &gt; 0" />
                </InArgument>
              </If.Condition>
              <If.Then>
                <Sequence DisplayName="Then">
                  <Assign x:TypeArguments="x:String" DisplayName="Set Scenario Folder">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:String">
                        <VisualBasicReference x:TypeArguments="x:String" ExpressionText="scenarioFolder" />
                      </OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:String">
                        <VisualBasicValue x:TypeArguments="x:String" ExpressionText="Path.Combine(Environment.CurrentDirectory, &quot;TestData&quot;, &quot;Attachments&quot;, scenarioId)" />
                      </InArgument>
                    </Assign.Value>
                  </Assign>
                  <ui:CreateDirectory DisplayName="Create Scenario Folder" Path="[scenarioFolder]" />
                  <umam:DownloadEmailAttachments ConnectionId="1c702018-5e37-436e-8ec9-9ba68419b88b" ConflictResolution="Replace" DestinationPath="[scenarioFolder]" DisplayName="Download Attachments" Email="[email]" ExcludeInlineAttachments="True" SearchMode="UseSimple" UseConnectionService="True" />
                  <Assign x:TypeArguments="x:Int32" DisplayName="Count Saved Email">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Int32">
                        <VisualBasicReference x:TypeArguments="x:Int32" ExpressionText="savedEmails" />
                      </OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Int32">
                        <VisualBasicValue x:TypeArguments="x:Int32" ExpressionText="savedEmails + 1" />
                      </InArgument>
                    </Assign.Value>
                  </Assign>
                  <ui:LogMessage Level="Info" DisplayName="Log Saved Files">
                    <ui:LogMessage.Message>
                      <InArgument x:TypeArguments="x:Object">
                        <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;{scenarioId}: {String.Join(&quot;, &quot;, Directory.GetFiles(scenarioFolder).Select(Function(f) Path.GetFileName(f)))}&quot;" />
                      </InArgument>
                    </ui:LogMessage.Message>
                  </ui:LogMessage>
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence DisplayName="Else">
                  <If DisplayName="Unknown Email?">
                    <If.Condition>
                      <InArgument x:TypeArguments="x:Boolean">
                        <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="scenarioId Is Nothing" />
                      </InArgument>
                    </If.Condition>
                    <If.Then>
                      <Sequence DisplayName="Then">
                        <ui:LogMessage Level="Warn" DisplayName="Log Unknown Email">
                          <ui:LogMessage.Message>
                            <InArgument x:TypeArguments="x:Object">
                              <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;Not in the expected results: {email.Subject}&quot;" />
                            </InArgument>
                          </ui:LogMessage.Message>
                        </ui:LogMessage>
                      </Sequence>
                    </If.Then>
                  </If>
                </Sequence>
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage Level="Info" DisplayName="Log Summary">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;Emails in Inbox: {inboxEmails.Count}, emails with saved attachments: {savedEmails}&quot;" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>
