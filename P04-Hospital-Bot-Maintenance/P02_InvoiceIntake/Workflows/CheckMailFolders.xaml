  <Sequence DisplayName="Check Mail Folders" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(ummm:O365MailFolder)" Name="mailFolders" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="folderNames" />
    </Sequence.Variables>
    <umam:GetEmailFoldersListConnections ConnectionAccountName="{x:Null}" AuthScopesInvalid="False" ConnectionId="1c702018-5e37-436e-8ec9-9ba68419b88b" DisplayName="Get Mailbox Folders" Result="[mailFolders]" UseConnectionService="True" sap2010:WorkflowViewState.IdRef="GetEmailFoldersListConnections_1">
      <umam:GetEmailFoldersListConnections.MailboxArg>
        <umamm:MailboxArgument UseSharedMailbox="True">
          <umamm:MailboxArgument.Backup>
            <usau:BackupSlot x:TypeArguments="umame:MailboxSelectionMode" StoredValue="NoMailbox">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umame:MailboxSelectionMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umamm:MailboxArgument.Backup>
          <umamm:MailboxArgument.SharedMailbox>
            <InArgument x:TypeArguments="x:String">[in_Config("InvoiceMailbox")]</InArgument>
          </umamm:MailboxArgument.SharedMailbox>
        </umamm:MailboxArgument>
      </umam:GetEmailFoldersListConnections.MailboxArg>
    </umam:GetEmailFoldersListConnections>
    <Assign x:TypeArguments="scg:List(x:String)" DisplayName="Get Folder Names" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[folderNames]" Value="[mailFolders.Select(Function(f) f.Name.ToLower()).ToList()]" />
    <If Condition="[Not folderNames.Contains(in_Config(&quot;Folder_Inbox&quot;).ToLower())]" DisplayName="Inbox Folder Missing?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Throw DisplayName="Throw Inbox Folder Error" Exception="[New Exception($&quot;Wrong setting Folder_Inbox in Data/Config.xlsx: the folder '{in_Config(&quot;Folder_Inbox&quot;)}' was not found in the mailbox {in_Config(&quot;InvoiceMailbox&quot;)}. No email was handled.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Then>
    </If>
    <If Condition="[Not folderNames.Contains(in_Config(&quot;Folder_Processed&quot;).ToLower())]" DisplayName="Processed Folder Missing?" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Throw DisplayName="Throw Processed Folder Error" Exception="[New Exception($&quot;Wrong setting Folder_Processed in Data/Config.xlsx: the folder '{in_Config(&quot;Folder_Processed&quot;)}' was not found in the mailbox {in_Config(&quot;InvoiceMailbox&quot;)}. No email was handled.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_2" />
      </If.Then>
    </If>
    <If Condition="[Not folderNames.Contains(in_Config(&quot;Folder_Review&quot;).ToLower())]" DisplayName="Review Folder Missing?" sap2010:WorkflowViewState.IdRef="If_3">
      <If.Then>
        <Throw DisplayName="Throw Review Folder Error" Exception="[New Exception($&quot;Wrong setting Folder_Review in Data/Config.xlsx: the folder '{in_Config(&quot;Folder_Review&quot;)}' was not found in the mailbox {in_Config(&quot;InvoiceMailbox&quot;)}. No email was handled.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_3" />
      </If.Then>
    </If>
    <If Condition="[Not folderNames.Contains(in_Config(&quot;Folder_Error&quot;).ToLower())]" DisplayName="Error Folder Missing?" sap2010:WorkflowViewState.IdRef="If_4">
      <If.Then>
        <Throw DisplayName="Throw Error Folder Error" Exception="[New Exception($&quot;Wrong setting Folder_Error in Data/Config.xlsx: the folder '{in_Config(&quot;Folder_Error&quot;)}' was not found in the mailbox {in_Config(&quot;InvoiceMailbox&quot;)}. No email was handled.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_4" />
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Folders OK" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Mail folders checked: {in_Config(&quot;Folder_Inbox&quot;)}, {in_Config(&quot;Folder_Processed&quot;)}, {in_Config(&quot;Folder_Review&quot;)} and {in_Config(&quot;Folder_Error&quot;)} exist.&quot;]" />
  </Sequence>
</Activity>
