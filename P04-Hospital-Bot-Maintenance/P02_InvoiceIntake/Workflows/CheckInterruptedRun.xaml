  <Sequence DisplayName="Check Interrupted Run" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(x:String)" Name="inboxIds" />
      <Variable x:TypeArguments="scg:List(x:String)" Name="finishedIds" />
      <Variable x:TypeArguments="scg:List(sd:DataRow)" Name="interrupted" />
      <Variable x:TypeArguments="x:String" Name="subject" />
      <Variable x:TypeArguments="x:String" Name="body" />
      <Variable x:TypeArguments="x:String" Name="checkedAt" />
    </Sequence.Variables>
    <Assign x:TypeArguments="scg:List(x:String)" DisplayName="Get Inbox Ids" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[inboxIds]" Value="[in_InboxEmails.Select(Function(m) m.InternetMessageId).ToList()]" />
    <Assign x:TypeArguments="scg:List(x:String)" DisplayName="Get Finished Ids" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[finishedIds]" Value="[in_ProcessedLog.Select(&quot;Folder NOT LIKE 'Started%'&quot;).Select(Function(r) r(&quot;InternetMessageId&quot;).ToString()).ToList()]" />
    <Assign x:TypeArguments="scg:List(sd:DataRow)" DisplayName="Find Interrupted Emails" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[interrupted]" Value="[in_ProcessedLog.Select(&quot;Folder LIKE 'Started%'&quot;).Where(Function(r) Not finishedIds.Contains(r(&quot;InternetMessageId&quot;).ToString()) AndAlso Not inboxIds.Contains(r(&quot;InternetMessageId&quot;).ToString())).ToList()]" />
    <If Condition="[interrupted.Count &gt; 0]" DisplayName="Was the Last Run Interrupted?" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Report Interrupted Emails" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Assign x:TypeArguments="x:String" DisplayName="Build Notice Subject" sap2010:WorkflowViewState.IdRef="Assign`1_4" To="[subject]" Value="[$&quot;Avbruten körning: {interrupted.Count} mejl behöver kontrolleras&quot;]" />
          <Assign x:TypeArguments="x:String" DisplayName="Build Notice Text" sap2010:WorkflowViewState.IdRef="Assign`1_5" To="[body]" Value="[String.Join(vbCrLf, {&quot;Hej,&quot;, &quot;&quot;, &quot;Robotens förra körning stoppades innan den var klar. Dessa mejl hade redan flyttats, men aviseringen eller svaret kan saknas. Kontrollera dem för hand:&quot;, &quot;&quot;}.Concat(interrupted.Select(Function(r) &quot;- &quot; &amp; r(&quot;Subject&quot;).ToString() &amp; &quot; (mapp: &quot; &amp; r(&quot;Folder&quot;).ToString().Replace(&quot;Started: &quot;, &quot;&quot;) &amp; &quot;)&quot;)).Concat({&quot;&quot;, &quot;Hälsningar&quot;, &quot;Fakturaroboten&quot;}))]" />
          <umam:SendMailConnections ConnectionId="1c702018-5e37-436e-8ec9-9ba68419b88b" DisplayName="Send Interrupted Run Notice" Importance="Normal" InputType="TEXT" IsDeliveryReceiptRequested="False" IsReadReceiptRequested="False" SaveAsDraft="False" Subject="[subject]" TextBody="[body]" To="[New String() {in_Config(&quot;ReviewRecipient&quot;)}]" UseConnectionService="True" sap2010:WorkflowViewState.IdRef="SendMailConnections_1">
            <umam:SendMailConnections.InputTypeBackup>
              <usau:BackupSlot x:TypeArguments="umame:BodyInputType" StoredValue="TEXT">
                <usau:BackupSlot.BackupValues>
                  <scg:Dictionary x:TypeArguments="umame:BodyInputType, scg:List(x:Object)" />
                </usau:BackupSlot.BackupValues>
              </usau:BackupSlot>
            </umam:SendMailConnections.InputTypeBackup>
            <umam:SendMailConnections.AttachmentsBackup>
              <usau:BackupSlot x:TypeArguments="umame:AttachmentInputMode" StoredValue="Existing">
                <usau:BackupSlot.BackupValues>
                  <scg:Dictionary x:TypeArguments="umame:AttachmentInputMode, scg:List(x:Object)" />
                </usau:BackupSlot.BackupValues>
              </usau:BackupSlot>
            </umam:SendMailConnections.AttachmentsBackup>
            <umam:SendMailConnections.MailboxArg>
              <umamm:MailboxArgument UseSharedMailbox="True">
                <umamm:MailboxArgument.Backup>
                  <usau:BackupSlot x:TypeArguments="umame:MailboxSelectionMode" StoredValue="NoMailbox">
                    <usau:BackupSlot.BackupValues>
                      <scg:Dictionary x:TypeArguments="umame:MailboxSelectionMode, scg:List(x:Object)" />
                    </usau:BackupSlot.BackupValues>
                  </usau:BackupSlot>
                </umamm:MailboxArgument.Backup>
                <umamm:MailboxArgument.SharedMailbox>
                  <InArgument x:TypeArguments="x:String">[in_Config(&quot;InvoiceMailbox&quot;)]</InArgument>
                </umamm:MailboxArgument.SharedMailbox>
              </umamm:MailboxArgument>
            </umam:SendMailConnections.MailboxArg>
          </umam:SendMailConnections>
          <Assign x:TypeArguments="x:String" DisplayName="Get Time" sap2010:WorkflowViewState.IdRef="Assign`1_6" To="[checkedAt]" Value="[Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)]" />
          <ui:ForEach x:TypeArguments="sd:DataRow" CurrentIndex="{x:Null}" DisplayName="For Each Interrupted Email" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[interrupted]">
            <ui:ForEach.Body>
              <ActivityAction x:TypeArguments="sd:DataRow">
                <ActivityAction.Argument>
                  <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                </ActivityAction.Argument>
                <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <ui:LogMessage DisplayName="Log Interrupted Email" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Warn" Message="[$&quot;Interrupted in an earlier run, Finance asked to check it: {row(&quot;Subject&quot;)} ({row(&quot;Folder&quot;)})&quot;]" />
                  <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{checkedAt, &quot;&quot;, row(&quot;Subject&quot;).ToString(), &quot;&quot;, &quot;&quot;, row(&quot;Class&quot;).ToString(), &quot;The last run stopped before this email was finished&quot;, row(&quot;Folder&quot;).ToString().Replace(&quot;Started: &quot;, &quot;&quot;), &quot;Interrupted run notice&quot;, row(&quot;InternetMessageId&quot;).ToString()}]" DataTable="[in_Report]" DisplayName="Add Report Row" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
                  <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{row(&quot;InternetMessageId&quot;).ToString(), row(&quot;Subject&quot;).ToString(), row(&quot;Class&quot;).ToString(), &quot;Interrupted&quot;, checkedAt}]" DataTable="[in_ProcessedLog]" DisplayName="Add Log Row" sap2010:WorkflowViewState.IdRef="AddDataRow_2" />
                </Sequence>
              </ActivityAction>
            </ui:ForEach.Body>
          </ui:ForEach>
          <ui:WriteCsvFile AddHeaders="True" DataTable="[in_ProcessedLog]" Delimitator="Semicolon" DelimitatorForViewModel="Semicolon" DisplayName="Save Processed Log" FilePath="[in_LogPath]" sap2010:WorkflowViewState.IdRef="WriteCsvFile_1" ShouldQuote="True" />
        </Sequence>
      </If.Then>
      <If.Else>
        <ui:LogMessage DisplayName="Log No Interrupted Emails" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;No unfinished emails from an earlier run.&quot;]" />
      </If.Else>
    </If>
  </Sequence>
</Activity>
