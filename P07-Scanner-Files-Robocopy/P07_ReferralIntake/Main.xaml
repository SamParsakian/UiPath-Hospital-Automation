    <Assign x:TypeArguments="s:DateTime" DisplayName="Save Start Time" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[startTime]" Value="[Now]" />
    <If Condition="[String.IsNullOrWhiteSpace(in_ListDate)]" DisplayName="List Date Given?" sap2010:WorkflowViewState.IdRef="If_1">
