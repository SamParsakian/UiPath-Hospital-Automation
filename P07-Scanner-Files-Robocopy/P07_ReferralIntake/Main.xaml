        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Assign x:TypeArguments="x:String" DisplayName="Use Given Date" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[listDate]" Value="[in_ListDate.Trim()]" />
        </Sequence>
      </If.Else>
    </If>
    <ui:LogMessage DisplayName="Log Start" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;Referral intake started for {listDate}. Robocopy copies the new scans from {in_ShareFolder}&quot;]" />
