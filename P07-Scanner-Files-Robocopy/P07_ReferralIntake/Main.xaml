    <Assign x:TypeArguments="x:String" DisplayName="Get Script Path" sap2010:WorkflowViewState.IdRef="Assign`1_8" To="[scriptPath]" Value="[Path.Combine(Environment.CurrentDirectory, &quot;Scripts\Copy-NewReferrals.ps1&quot;)]" />
    <ui:InvokePowerShell x:TypeArguments="x:Int32" ContinueOnError="{x:Null}" CommandText="[scriptPath]" DisplayName="Run Copy-NewReferrals.ps1" sap2010:WorkflowViewState.IdRef="InvokePowerShell`1_1" Output="[scriptResults]" PowerShellProcess="WindowsPowerShell64">
      <ui:InvokePowerShell.Parameters>
        <InArgument x:TypeArguments="x:String" x:Key="Source">[in_ShareFolder]</InArgument>
