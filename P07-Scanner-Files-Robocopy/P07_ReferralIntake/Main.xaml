    <ui:LogMessage DisplayName="Log Summary" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[$&quot;Referral list written: {listPath} with {dt_ReferralList.Rows.Count} referrals. Total run time {(Now - startTime).ToString(&quot;hh\:mm\:ss&quot;)}&quot;]" />
