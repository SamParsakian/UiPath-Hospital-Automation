    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Line in Log" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[logLines]">
      <ui:ForEach.Body>
