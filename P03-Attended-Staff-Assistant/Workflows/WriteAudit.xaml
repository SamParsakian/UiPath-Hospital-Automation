      </If.Else>
    </If>
    <Assign x:TypeArguments="x:String" DisplayName="Set Audit File" sap2010:WorkflowViewState.IdRef="Assign`1_10" To="[auditFile]" Value="[Path.Combine(auditFolder, &quot;audit_log.csv&quot;)]" />
