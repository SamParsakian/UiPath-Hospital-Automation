  <Sequence DisplayName="Write Audit" sap2010:WorkflowViewState.IdRef="Sequence_8">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="auditFolder" />
      <Variable x:TypeArguments="x:String" Name="auditFile" />
    </Sequence.Variables>
    <If Condition="[Path.IsPathRooted(in_Config(&quot;AuditFolder&quot;))]" DisplayName="Is the Audit Folder a Full Path?" sap2010:WorkflowViewState.IdRef="If_4">
      <If.Then>
