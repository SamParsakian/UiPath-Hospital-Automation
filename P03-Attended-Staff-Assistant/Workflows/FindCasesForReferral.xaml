            <uix:NGetText DisplayName="Get Number Of Cases" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NGetText_5" ScopeIdentifier="4d1bd843-fe8f-488a-bb30-9966d14ba36d" TextString="[listHeader]" Version="V5">
              <uix:NGetText.Target>
                <uix:TargetAnchorable ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl class='list-meta' tag='DIV' /&gt;&lt;webctrl tag='B' /&gt;" Guid="253cebe7-ef74-44fa-825d-1b50f3aac6c6" ScopeSelectorArgument="&lt;html app='chrome.exe' url='http://100.99.72.90:8081/*' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
