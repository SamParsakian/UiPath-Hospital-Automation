                <uix:NGetText DisplayName="Get Case ID" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NGetText_4" ScopeIdentifier="4d1bd843-fe8f-488a-bb30-9966d14ba36d" TextString="[caseId]" Version="V5">
