                  <Assign x:TypeArguments="x:String" DisplayName="Keep Error Message 1" sap2010:WorkflowViewState.IdRef="Assign`1_15" To="[saveMessage]" Value="[exception.Message]" />
                  <ui:LogMessage DisplayName="Log Save Error 1" sap2010:WorkflowViewState.IdRef="LogMessage_6" Level="Warn" Message="[&quot;Saving &quot; &amp; in_CaseId &amp; &quot; failed: &quot; &amp; exception.Message]" />
