  <Sequence DisplayName="Get Fact Value" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:String[]" Name="lines" />
    </Sequence.Variables>
    <Assign x:TypeArguments="x:String" DisplayName="Start With No Value" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[out_Value]" Value="[&quot;&quot;]" />
    <Assign x:TypeArguments="s:String[]" DisplayName="Split Text Into Lines" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[lines]" Value="[in_Text.Split(vbLf.ToCharArray())]" />
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Line" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[lines]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="line" />
          </ActivityAction.Argument>
          <If Condition="[out_Value = &quot;&quot; AndAlso line.Trim().StartsWith(in_Label)]" DisplayName="Does the Line Start With the Label?" sap2010:WorkflowViewState.IdRef="If_1">
            <If.Then>
              <Assign x:TypeArguments="x:String" DisplayName="Take the Rest As Value" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[out_Value]" Value="[line.Trim().Substring(in_Label.Length).Trim()]" />
            </If.Then>
          </If>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage DisplayName="Log Fact Found" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[&quot;Fact &quot; &amp; in_Label &amp; &quot; found: &quot; &amp; (out_Value &lt;&gt; &quot;&quot;).ToString()]" />
  </Sequence>
