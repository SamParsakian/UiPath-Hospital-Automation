    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Test Logins" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="coordinatorRole" />
      <Variable x:TypeArguments="x:String" Name="coderRole" />
    </Sequence.Variables>
    <ui:InvokeWorkflowFile DisplayName="Log In As Coordinator" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" WorkflowFileName="Workflows\Login_Coordination.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="x:String" x:Key="in_CredentialTarget">P03_Samordnare</InArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_UserRole">[coordinatorRole]</OutArgument>
        </scg:Dictionary>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <If DisplayName="If Coordinator Role Is Wrong" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Condition>[coordinatorRole.Trim() &lt;&gt; "Samordnare"]</If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Throw DisplayName="Throw Wrong Coordinator Role" Exception="[New Exception(&quot;P03_Samordnare logged in with role '&quot; &amp; coordinatorRole &amp; &quot;', expected 'Samordnare'.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Coordinator OK" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[&quot;PASS: P03_Samordnare works, role &quot; &amp; coordinatorRole]" />
    <ui:InvokeWorkflowFile DisplayName="Log In As Coder" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_2" WorkflowFileName="Workflows\Login_Coordination.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <scg:Dictionary x:TypeArguments="x:String, Argument">
          <InArgument x:TypeArguments="x:String" x:Key="in_CredentialTarget">P03_Kodare</InArgument>
          <OutArgument x:TypeArguments="x:String" x:Key="out_UserRole">[coderRole]</OutArgument>
        </scg:Dictionary>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <If DisplayName="If Coder Role Is Wrong" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Condition>[coderRole.Trim() &lt;&gt; "Kodare"]</If.Condition>
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
          <Throw DisplayName="Throw Wrong Coder Role" Exception="[New Exception(&quot;P03_Kodare logged in with role '&quot; &amp; coderRole &amp; &quot;', expected 'Kodare'.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_2" />
        </Sequence>
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Coder OK" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;PASS: P03_Kodare works, role &quot; &amp; coderRole]" />
  </Sequence>
