      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Test Check Report" sap2010:WorkflowViewState.IdRef="Sequence_6">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:Dictionary(x:String, x:String)" Name="config" />
      <Variable x:TypeArguments="x:String" Name="reportFolder" />
      <Variable x:TypeArguments="x:String" Name="reportPath" />
      <Variable x:TypeArguments="s:DateTime" Default="[DateTime.MinValue]" Name="newestTime" />
      <Variable x:TypeArguments="sd:DataTable" Name="report" />
      <Variable x:TypeArguments="sd:DataTable" Name="expected" />
      <Variable x:TypeArguments="x:Int32" Default="0" Name="passedCount" />
    </Sequence.Variables>
    <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke Read Config" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows\ReadConfig.xaml">
      <ui:InvokeWorkflowFile.Arguments>
        <OutArgument x:TypeArguments="scg:Dictionary(x:String, x:String)" x:Key="out_Config">[config]</OutArgument>
      </ui:InvokeWorkflowFile.Arguments>
    </ui:InvokeWorkflowFile>
    <Assign x:TypeArguments="x:String" DisplayName="Set Report Folder" sap2010:WorkflowViewState.IdRef="Assign`1_13" To="[reportFolder]" Value="[Path.Combine(Environment.CurrentDirectory, config(&quot;ReportFolder&quot;))]" />
    <Assign x:TypeArguments="x:String" DisplayName="Set No Report Yet" sap2010:WorkflowViewState.IdRef="Assign`1_14" To="[reportPath]" Value="[&quot;&quot;]" />
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Report File" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[Directory.GetFiles(reportFolder, &quot;Report_*.xlsx&quot;)]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="reportFile" />
          </ActivityAction.Argument>
          <If Condition="[File.GetLastWriteTime(reportFile) &gt; newestTime]" DisplayName="Is It Newer?" sap2010:WorkflowViewState.IdRef="If_3">
            <If.Then>
              <Sequence DisplayName="Remember File" sap2010:WorkflowViewState.IdRef="Sequence_5">
                <Assign x:TypeArguments="x:String" DisplayName="Remember Report Path" sap2010:WorkflowViewState.IdRef="Assign`1_11" To="[reportPath]" Value="[reportFile]" />
                <Assign x:TypeArguments="s:DateTime" DisplayName="Remember Time" sap2010:WorkflowViewState.IdRef="Assign`1_12" To="[newestTime]" Value="[File.GetLastWriteTime(reportFile)]" />
              </Sequence>
            </If.Then>
          </If>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <If Condition="[reportPath = &quot;&quot;]" DisplayName="No Report Found?" sap2010:WorkflowViewState.IdRef="If_4">
      <If.Then>
        <Throw DisplayName="Throw No Report" Exception="[New Exception(&quot;No report was found in the Output folder.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_1" />
      </If.Then>
    </If>
    <ui:LogMessage DisplayName="Log Report Name" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[$&quot;Checking {Path.GetFileName(reportPath)}&quot;]" />
    <ui:ReadRange AddHeaders="True" DataTable="[report]" DisplayName="Read Report" Range="" SheetName="Report" WorkbookPath="[reportPath]" sap2010:WorkflowViewState.IdRef="ReadRange_1" />
    <ui:ReadCsvFile PathResource="{x:Null}" DataTable="[expected]" Delimitator="Semicolon" DelimitatorForViewModel="Semicolon" DisplayName="Read Expected Results" FilePath="[Path.Combine(Environment.CurrentDirectory, &quot;TestData&quot;, &quot;expected_results.csv&quot;)]" sap2010:WorkflowViewState.IdRef="ReadCsvFile_1" />
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[expected]" DisplayName="For Each Expected Email" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_4">
            <Sequence.Variables>
              <Variable x:TypeArguments="sd:DataRow[]" Name="reportRows" />
              <Variable x:TypeArguments="x:String" Name="actualClass" />
              <Variable x:TypeArguments="x:String" Name="actualFolder" />
              <Variable x:TypeArguments="x:String" Name="actualMail" />
              <Variable x:TypeArguments="x:String" Name="expectedMail" />
              <Variable x:TypeArguments="x:Boolean" Name="passed" />
            </Sequence.Variables>
            <Assign x:TypeArguments="sd:DataRow[]" DisplayName="Find Report Row" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[reportRows]" Value="[report.Select(&quot;InternetMessageId = '&quot; &amp; CurrentRow(&quot;InternetMessageId&quot;).ToString().Replace(&quot;'&quot;, &quot;''&quot;) &amp; &quot;'&quot;)]" />
            <If Condition="[reportRows.Length = 0]" DisplayName="Is the Email Missing?" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <Sequence DisplayName="Email Missing" sap2010:WorkflowViewState.IdRef="Sequence_1">
                  <Assign x:TypeArguments="x:String" DisplayName="Set Missing Class" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[actualClass]" Value="[&quot;(missing)&quot;]" />
                  <Assign x:TypeArguments="x:String" DisplayName="Set Missing Folder" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[actualFolder]" Value="[&quot;(missing)&quot;]" />
                  <Assign x:TypeArguments="x:String" DisplayName="Set Missing Mail" sap2010:WorkflowViewState.IdRef="Assign`1_4" To="[actualMail]" Value="[&quot;(missing)&quot;]" />
                </Sequence>
              </If.Then>
              <If.Else>
                <Sequence DisplayName="Email Found" sap2010:WorkflowViewState.IdRef="Sequence_2">
                  <Assign x:TypeArguments="x:String" DisplayName="Get Actual Class" sap2010:WorkflowViewState.IdRef="Assign`1_5" To="[actualClass]" Value="[reportRows(0)(&quot;Class&quot;).ToString()]" />
                  <Assign x:TypeArguments="x:String" DisplayName="Get Actual Folder" sap2010:WorkflowViewState.IdRef="Assign`1_6" To="[actualFolder]" Value="[reportRows(0)(&quot;Folder&quot;).ToString()]" />
                  <Assign x:TypeArguments="x:String" DisplayName="Get Actual Mail" sap2010:WorkflowViewState.IdRef="Assign`1_7" To="[actualMail]" Value="[reportRows(0)(&quot;MailSent&quot;).ToString()]" />
                </Sequence>
              </If.Else>
            </If>
            <Assign x:TypeArguments="x:String" DisplayName="Get Expected Mail" sap2010:WorkflowViewState.IdRef="Assign`1_8" To="[expectedMail]" Value="[If(CurrentRow(&quot;NotificationExpected&quot;).ToString() = &quot;Yes&quot;, &quot;Review notification&quot;, If(CurrentRow(&quot;ReplyExpected&quot;).ToString() = &quot;Yes&quot;, &quot;Error reply (test mode)&quot;, &quot;None&quot;))]" />
            <Assign x:TypeArguments="x:Boolean" DisplayName="Compare With Expected" sap2010:WorkflowViewState.IdRef="Assign`1_9" To="[passed]" Value="[actualClass = CurrentRow(&quot;ExpectedClass&quot;).ToString() AndAlso actualFolder = CurrentRow(&quot;ExpectedFolder&quot;).ToString() AndAlso actualMail = expectedMail]" />
            <If Condition="[passed]" DisplayName="Passed?" sap2010:WorkflowViewState.IdRef="If_2">
              <If.Then>
                <Sequence DisplayName="Count Passed" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <Assign x:TypeArguments="x:Int32" DisplayName="Count Passed" sap2010:WorkflowViewState.IdRef="Assign`1_10" To="[passedCount]" Value="[passedCount + 1]" />
                  <ui:LogMessage DisplayName="Log Passed" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Info" Message="[$&quot;OK   {CurrentRow(&quot;ScenarioId&quot;)}: {actualClass} -&gt; {actualFolder}, mail: {actualMail}&quot;]" />
                </Sequence>
              </If.Then>
              <If.Else>
                <ui:LogMessage DisplayName="Log Failed" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Warn" Message="[$&quot;FAIL {CurrentRow(&quot;ScenarioId&quot;)}: expected {CurrentRow(&quot;ExpectedClass&quot;)} -&gt; {CurrentRow(&quot;ExpectedFolder&quot;)}, mail: {expectedMail}; got {actualClass} -&gt; {actualFolder}, mail: {actualMail}&quot;]" />
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:LogMessage DisplayName="Log Summary" sap2010:WorkflowViewState.IdRef="LogMessage_4" Level="Info" Message="[$&quot;Report check: {passedCount} of {expected.Rows.Count} emails have the expected class, folder and mail.&quot;]" />
    <If Condition="[passedCount &lt;&gt; expected.Rows.Count]" DisplayName="Any Failed?" sap2010:WorkflowViewState.IdRef="If_5">
      <If.Then>
        <Throw DisplayName="Throw Test Failed" Exception="[New Exception($&quot;FAILED: {expected.Rows.Count - passedCount} emails do not match the expected results.&quot;)]" sap2010:WorkflowViewState.IdRef="Throw_2" />
      </If.Then>
    </If>
  </Sequence>
</Activity>
