  <Sequence DisplayName="Test Read Invoice" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="expectedFiles" />
      <Variable x:TypeArguments="sd:DataTable" Name="testResults" />
      <Variable x:TypeArguments="x:Int32" Name="passedCount" Default="0" />
      <Variable x:TypeArguments="sg:CultureInfo" Name="swedish" Default="[CultureInfo.GetCultureInfo(&quot;sv-SE&quot;)]" />
    </Sequence.Variables>
    <ui:ReadCsvFile DataTable="[expectedFiles]" Delimitator="Semicolon" DelimitatorForViewModel="Semicolon" DisplayName="Read Expected Files" FilePath="[Path.Combine(Environment.CurrentDirectory, &quot;TestData&quot;, &quot;read_invoice_expected.csv&quot;)]" IncludeColumnNames="True" />
    <ui:BuildDataTable DataTable="[testResults]" DisplayName="Build Results Table" TableInfo="&lt;NewDataSet&gt;&#xD;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xD;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;Results&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xD;&#xA;      &lt;xs:complexType&gt;&#xD;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xD;&#xA;          &lt;xs:element name=&quot;Results&quot;&gt;&#xD;&#xA;            &lt;xs:complexType&gt;&#xD;&#xA;              &lt;xs:sequence&gt;&#xD;&#xA;                &lt;xs:element name=&quot;ScenarioId&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;FileName&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;ExpectedResult&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;Result&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;DocumentType&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;Supplier&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;OrgNumber&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;InvoiceNumber&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;InvoiceDate&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;DueDate&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;PurchaseOrder&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;CostCentre&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;NetAmount&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;VatAmount&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;TotalAmount&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;Bankgiro&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;Reason&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;                &lt;xs:element name=&quot;Passed&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xD;&#xA;              &lt;/xs:sequence&gt;&#xD;&#xA;            &lt;/xs:complexType&gt;&#xD;&#xA;          &lt;/xs:element&gt;&#xD;&#xA;        &lt;/xs:choice&gt;&#xD;&#xA;      &lt;/xs:complexType&gt;&#xD;&#xA;    &lt;/xs:element&gt;&#xD;&#xA;  &lt;/xs:schema&gt;&#xD;&#xA;&lt;/NewDataSet&gt;" />
    <ui:ForEachRow ColumnNames="{x:Null}" CurrentIndex="{x:Null}" DataTable="[expectedFiles]" DisplayName="For Each Test File">
      <ui:ForEachRow.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="CurrentRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <Sequence.Variables>
              <Variable x:TypeArguments="x:String" Name="result" />
              <Variable x:TypeArguments="x:String" Name="reason" />
              <Variable x:TypeArguments="x:String" Name="documentType" />
              <Variable x:TypeArguments="x:String" Name="supplierName" />
              <Variable x:TypeArguments="x:String" Name="orgNumber" />
              <Variable x:TypeArguments="x:String" Name="invoiceNumber" />
              <Variable x:TypeArguments="x:String" Name="invoiceDate" />
              <Variable x:TypeArguments="x:String" Name="dueDate" />
              <Variable x:TypeArguments="x:String" Name="purchaseOrder" />
              <Variable x:TypeArguments="x:String" Name="costCentre" />
              <Variable x:TypeArguments="x:Decimal" Name="netAmount" />
              <Variable x:TypeArguments="x:Decimal" Name="vatAmount" />
              <Variable x:TypeArguments="x:Decimal" Name="totalAmount" />
              <Variable x:TypeArguments="x:String" Name="bankgiro" />
              <Variable x:TypeArguments="x:Boolean" Name="passed" />
            </Sequence.Variables>
            <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke Read Invoice" UnSafe="False" WorkflowFileName="Workflows\ReadInvoice.xaml">
              <ui:InvokeWorkflowFile.Arguments>
                <scg:Dictionary x:TypeArguments="x:String, Argument">
                  <InArgument x:TypeArguments="x:String" x:Key="in_FilePath">[Path.Combine(Environment.CurrentDirectory, "TestData", "Attachments", CurrentRow("ScenarioId").ToString(), CurrentRow("FileName").ToString())]</InArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_Result">[result]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_Reason">[reason]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_DocumentType">[documentType]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_SupplierName">[supplierName]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_OrgNumber">[orgNumber]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_InvoiceNumber">[invoiceNumber]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_InvoiceDate">[invoiceDate]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_DueDate">[dueDate]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_PurchaseOrder">[purchaseOrder]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_CostCentre">[costCentre]</OutArgument>
                  <OutArgument x:TypeArguments="x:Decimal" x:Key="out_NetAmount">[netAmount]</OutArgument>
                  <OutArgument x:TypeArguments="x:Decimal" x:Key="out_VatAmount">[vatAmount]</OutArgument>
                  <OutArgument x:TypeArguments="x:Decimal" x:Key="out_TotalAmount">[totalAmount]</OutArgument>
                  <OutArgument x:TypeArguments="x:String" x:Key="out_Bankgiro">[bankgiro]</OutArgument>
                </scg:Dictionary>
              </ui:InvokeWorkflowFile.Arguments>
            </ui:InvokeWorkflowFile>
            <Assign DisplayName="Compare With Expected">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Boolean">[passed]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Boolean">[result = CurrentRow("ExpectedResult").ToString() AndAlso (result &lt;&gt; "Invoice" OrElse (invoiceNumber = CurrentRow("InvoiceNumber").ToString() AndAlso purchaseOrder = CurrentRow("PurchaseOrder").ToString()))]</InArgument>
              </Assign.Value>
            </Assign>
            <ui:AddDataRow ArrayRow="[{CurrentRow(&quot;ScenarioId&quot;).ToString(), CurrentRow(&quot;FileName&quot;).ToString(), CurrentRow(&quot;ExpectedResult&quot;).ToString(), result, documentType, supplierName, orgNumber, invoiceNumber, invoiceDate, dueDate, purchaseOrder, costCentre, netAmount.ToString(&quot;N2&quot;, swedish), vatAmount.ToString(&quot;N2&quot;, swedish), totalAmount.ToString(&quot;N2&quot;, swedish), bankgiro, reason, If(passed, &quot;Yes&quot;, &quot;No&quot;)}]" DataRow="{x:Null}" DataTable="[testResults]" DisplayName="Add Result Row" />
            <If Condition="[passed]" DisplayName="Passed?">
              <If.Then>
                <Sequence DisplayName="Then">
                  <Assign DisplayName="Count Passed">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Int32">[passedCount]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Int32">[passedCount + 1]</InArgument>
                    </Assign.Value>
                  </Assign>
                  <ui:LogMessage Level="Info" DisplayName="Log Passed">
                    <ui:LogMessage.Message>
                      <InArgument x:TypeArguments="x:Object">[$"OK   {CurrentRow("ScenarioId")} {CurrentRow("FileName")}: {result} | {invoiceNumber} | {purchaseOrder} | {netAmount.ToString("N2", swedish)} + {vatAmount.ToString("N2", swedish)} = {totalAmount.ToString("N2", swedish)} | {reason}"]</InArgument>
                    </ui:LogMessage.Message>
                  </ui:LogMessage>
                </Sequence>
              </If.Then>
              <If.Else>
                <ui:LogMessage Level="Error" DisplayName="Log Failed">
                  <ui:LogMessage.Message>
                    <InArgument x:TypeArguments="x:Object">[$"FAIL {CurrentRow("ScenarioId")} {CurrentRow("FileName")}: expected {CurrentRow("ExpectedResult")} {CurrentRow("InvoiceNumber")} {CurrentRow("PurchaseOrder")}, got {result} {invoiceNumber} {purchaseOrder} | {reason}"]</InArgument>
                  </ui:LogMessage.Message>
                </ui:LogMessage>
              </If.Else>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEachRow.Body>
    </ui:ForEachRow>
    <ui:CreateDirectory DisplayName="Create Output Folder" Path="[Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;)]" />
    <Sequence DisplayName="Test Password-Protected PDF">
      <Sequence.Variables>
        <Variable x:TypeArguments="x:String" Name="lockedFile" Default="[Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;locked_49838.pdf&quot;)]" />
        <Variable x:TypeArguments="x:String" Name="lockedResult" />
        <Variable x:TypeArguments="x:String" Name="lockedReason" />
        <Variable x:TypeArguments="x:Boolean" Name="lockedPassed" />
      </Sequence.Variables>
      <upap:ManagePDFPassword DisplayName="Lock A Copy Of Invoice 49838" FileName="[Path.Combine(Environment.CurrentDirectory, &quot;TestData&quot;, &quot;Attachments&quot;, &quot;P02-E09&quot;, &quot;norrlands-livsmedelsgrossist-ab_49838.pdf&quot;)]" NewOwnerPassword="[Guid.NewGuid().ToString()]" NewUserPassword="[Guid.NewGuid().ToString()]" OutputFileName="[lockedFile]" />
      <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke Read Invoice" UnSafe="False" WorkflowFileName="Workflows\ReadInvoice.xaml">
        <ui:InvokeWorkflowFile.Arguments>
          <scg:Dictionary x:TypeArguments="x:String, Argument">
            <InArgument x:TypeArguments="x:String" x:Key="in_FilePath">[lockedFile]</InArgument>
            <OutArgument x:TypeArguments="x:String" x:Key="out_Result">[lockedResult]</OutArgument>
            <OutArgument x:TypeArguments="x:String" x:Key="out_Reason">[lockedReason]</OutArgument>
          </scg:Dictionary>
        </ui:InvokeWorkflowFile.Arguments>
      </ui:InvokeWorkflowFile>
      <Assign DisplayName="Compare With Expected">
        <Assign.To>
          <OutArgument x:TypeArguments="x:Boolean">[lockedPassed]</OutArgument>
        </Assign.To>
        <Assign.Value>
          <InArgument x:TypeArguments="x:Boolean">[lockedResult = "Error" AndAlso lockedReason.Contains("password")]</InArgument>
        </Assign.Value>
      </Assign>
      <ui:AddDataRow ArrayRow="[{&quot;Generated&quot;, Path.GetFileName(lockedFile), &quot;Error&quot;, lockedResult, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, &quot;&quot;, lockedReason, If(lockedPassed, &quot;Yes&quot;, &quot;No&quot;)}]" DataRow="{x:Null}" DataTable="[testResults]" DisplayName="Add Result Row" />
      <If Condition="[lockedPassed]" DisplayName="Passed?">
        <If.Then>
          <Sequence DisplayName="Then">
            <Assign DisplayName="Count Passed">
              <Assign.To>
                <OutArgument x:TypeArguments="x:Int32">[passedCount]</OutArgument>
              </Assign.To>
              <Assign.Value>
                <InArgument x:TypeArguments="x:Int32">[passedCount + 1]</InArgument>
              </Assign.Value>
            </Assign>
            <ui:LogMessage Level="Info" DisplayName="Log Passed">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object">[$"OK   Generated {Path.GetFileName(lockedFile)}: {lockedResult} | {lockedReason}"]</InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
          </Sequence>
        </If.Then>
        <If.Else>
          <ui:LogMessage Level="Error" DisplayName="Log Failed">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">[$"FAIL Generated {Path.GetFileName(lockedFile)}: expected Error with password, got {lockedResult} | {lockedReason}"]</InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
        </If.Else>
      </If>
    </Sequence>
    <ui:WriteCsvFile AddHeaders="True" DataTable="[testResults]" Delimitator="Semicolon" DelimitatorForViewModel="Semicolon" DisplayName="Write Test Results" FilePath="[Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;read_invoice_results.csv&quot;)]" ShouldQuote="True" />
    <ui:LogMessage Level="Info" DisplayName="Log Summary">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">[$"Test files: {testResults.Rows.Count}, passed: {passedCount}, failed: {testResults.Rows.Count - passedCount}"]</InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
  </Sequence>
</Activity>
