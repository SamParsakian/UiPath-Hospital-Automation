    <ui:BuildDataTable DataTable="[settings]" DisplayName="Build Settings Table" sap2010:WorkflowViewState.IdRef="BuildDataTable_1" TableInfo="&lt;NewDataSet&gt;&#xA;  &lt;xs:schema id=&quot;NewDataSet&quot; xmlns=&quot;&quot; xmlns:xs=&quot;http://www.w3.org/2001/XMLSchema&quot; xmlns:msdata=&quot;urn:schemas-microsoft-com:xml-msdata&quot;&gt;&#xA;    &lt;xs:element name=&quot;NewDataSet&quot; msdata:IsDataSet=&quot;true&quot; msdata:MainDataTable=&quot;Settings&quot; msdata:UseCurrentLocale=&quot;true&quot;&gt;&#xA;      &lt;xs:complexType&gt;&#xA;        &lt;xs:choice minOccurs=&quot;0&quot; maxOccurs=&quot;unbounded&quot;&gt;&#xA;          &lt;xs:element name=&quot;Settings&quot;&gt;&#xA;            &lt;xs:complexType&gt;&#xA;              &lt;xs:sequence&gt;&#xA;                &lt;xs:element name=&quot;Name&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Value&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;                &lt;xs:element name=&quot;Description&quot; type=&quot;xs:string&quot; minOccurs=&quot;0&quot; /&gt;&#xA;              &lt;/xs:sequence&gt;&#xA;            &lt;/xs:complexType&gt;&#xA;          &lt;/xs:element&gt;&#xA;        &lt;/xs:choice&gt;&#xA;      &lt;/xs:complexType&gt;&#xA;    &lt;/xs:element&gt;&#xA;  &lt;/xs:schema&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;InvoiceMailbox&lt;/Name&gt;&lt;Value&gt;fakturor@stockholmdemohospital.onmicrosoft.com&lt;/Value&gt;&lt;Description&gt;Shared mailbox that the robot reads&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Folder_Inbox&lt;/Name&gt;&lt;Value&gt;Inbox&lt;/Value&gt;&lt;Description&gt;Folder with new emails&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Folder_Processed&lt;/Name&gt;&lt;Value&gt;Processed&lt;/Value&gt;&lt;Description&gt;Folder for correct invoices&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Folder_Review&lt;/Name&gt;&lt;Value&gt;Review&lt;/Value&gt;&lt;Description&gt;Folder for invoices that need a person&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Folder_Error&lt;/Name&gt;&lt;Value&gt;Error&lt;/Value&gt;&lt;Description&gt;Folder for broken files or data&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Category_Processed&lt;/Name&gt;&lt;Value&gt;Robot: Processed&lt;/Value&gt;&lt;Description&gt;Category for correct invoices&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Category_Review&lt;/Name&gt;&lt;Value&gt;Robot: Review&lt;/Value&gt;&lt;Description&gt;Category for invoices that need a person&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Category_Error&lt;/Name&gt;&lt;Value&gt;Robot: Error&lt;/Value&gt;&lt;Description&gt;Category for broken files or data&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;Category_Ignored&lt;/Name&gt;&lt;Value&gt;Robot: Ignored&lt;/Value&gt;&lt;Description&gt;Category for emails that are not invoices&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;ReviewRecipient&lt;/Name&gt;&lt;Value&gt;frida.sjoberg@stockholmdemohospital.onmicrosoft.com&lt;/Value&gt;&lt;Description&gt;Controller who gets the review notifications&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;TestMode&lt;/Name&gt;&lt;Value&gt;True&lt;/Value&gt;&lt;Description&gt;When True, replies to suppliers go to the test recipient&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;TestReplyRecipient&lt;/Name&gt;&lt;Value&gt;frida.sjoberg@stockholmdemohospital.onmicrosoft.com&lt;/Value&gt;&lt;Description&gt;Receives the supplier replies in test mode&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;LabPortalUrl&lt;/Name&gt;&lt;Value&gt;http://100.99.72.90:8080&lt;/Value&gt;&lt;Description&gt;Address of Personalportalen&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;LabApiUrl&lt;/Name&gt;&lt;Value&gt;http://100.99.72.90:8082&lt;/Value&gt;&lt;Description&gt;Address of the hospital REST API&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;LabCredential&lt;/Name&gt;&lt;Value&gt;P01_HospitalDemo&lt;/Value&gt;&lt;Description&gt;Name of the Windows credential with the Personalportalen login (the password is not stored here)&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;LabApiCredential&lt;/Name&gt;&lt;Value&gt;P02_LabApi&lt;/Value&gt;&lt;Description&gt;Name of the Windows credential with the lab API login, role finance (the password is not stored here)&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;AttachmentFolder&lt;/Name&gt;&lt;Value&gt;Output\Attachments&lt;/Value&gt;&lt;Description&gt;Where the invoice files are saved during a run&lt;/Description&gt;&lt;/Settings&gt;&#xA;  &lt;Settings&gt;&lt;Name&gt;ReportFolder&lt;/Name&gt;&lt;Value&gt;Output&lt;/Value&gt;&lt;Description&gt;Where the report and the processed log are written&lt;/Description&gt;&lt;/Settings&gt;&#xA;&lt;/NewDataSet&gt;" />
