                            <Sequence DisplayName="Check Business Rules" sap2010:WorkflowViewState.IdRef="Sequence_2">
                              <Sequence.Variables>
                                <Variable x:TypeArguments="x:String" Name="checkClass" />
                                <Variable x:TypeArguments="x:String" Name="checkReason" />
                                <Variable x:TypeArguments="x:String" Name="checkSupplier" />
                              </Sequence.Variables>
                              <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" DisplayName="Invoke Check Invoice" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Workflows\CheckInvoice.xaml">
                                <ui:InvokeWorkflowFile.Arguments>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_SenderAddress">[senderAddress]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_Subject">[in_Email.Subject]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_InternalDomain">[internalDomain]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_DocumentResult">[readResult]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_OrgNumber">[orgNumber]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_InvoiceNumber">[invoiceNumber]</InArgument>
                                  <InArgument x:TypeArguments="x:String" x:Key="in_PurchaseOrder">[purchaseOrder]</InArgument>
                                  <InArgument x:TypeArguments="x:Decimal" x:Key="in_NetAmount">[netAmount]</InArgument>
                                  <InArgument x:TypeArguments="x:Decimal" x:Key="in_VatAmount">[vatAmount]</InArgument>
                                  <InArgument x:TypeArguments="sd:DataTable" x:Key="in_Suppliers">[in_Suppliers]</InArgument>
                                  <InArgument x:TypeArguments="sd:DataTable" x:Key="in_Invoices">[in_Invoices]</InArgument>
                                  <InArgument x:TypeArguments="sd:DataTable" x:Key="in_PurchaseOrders">[in_PurchaseOrders]</InArgument>
                                  <InArgument x:TypeArguments="sd:DataTable" x:Key="in_History">[in_History]</InArgument>
                                  <OutArgument x:TypeArguments="x:String" x:Key="out_Class">[checkClass]</OutArgument>
                                  <OutArgument x:TypeArguments="x:String" x:Key="out_Reason">[checkReason]</OutArgument>
                                  <OutArgument x:TypeArguments="x:String" x:Key="out_SupplierName">[checkSupplier]</OutArgument>
                                </ui:InvokeWorkflowFile.Arguments>
                              </ui:InvokeWorkflowFile>
                              <If Condition="[checkSupplier &lt;&gt; &quot;&quot;]" DisplayName="Supplier In Register?" sap2010:WorkflowViewState.IdRef="If_1">
                                <If.Then>
                                  <Assign x:TypeArguments="x:String" DisplayName="Use Registered Supplier Name" sap2010:WorkflowViewState.IdRef="Assign`1_1" To="[out_SupplierName]" Value="[checkSupplier]" />
                                </If.Then>
                              </If>
                              <If Condition="[checkClass = &quot;Invoice&quot;]" DisplayName="Did All Checks Pass?" sap2010:WorkflowViewState.IdRef="If_3">
                                <If.Then>
                                  <AddToCollection x:TypeArguments="x:String" Collection="[okInvoices]" DisplayName="Remember Correct Invoice" Item="[orgNumber &amp; &quot;|&quot; &amp; invoiceNumber]" sap2010:WorkflowViewState.IdRef="AddToCollection`1_1" />
                                </If.Then>
                                <If.Else>
                                  <If Condition="[reviewClass = &quot;&quot;]" DisplayName="First Problem?" sap2010:WorkflowViewState.IdRef="If_2">
                                    <If.Then>
                                      <Sequence DisplayName="Remember Problem" sap2010:WorkflowViewState.IdRef="Sequence_1">
                                        <Assign x:TypeArguments="x:String" DisplayName="Set Review Class" sap2010:WorkflowViewState.IdRef="Assign`1_2" To="[reviewClass]" Value="[checkClass]" />
                                        <Assign x:TypeArguments="x:String" DisplayName="Set Review Reason" sap2010:WorkflowViewState.IdRef="Assign`1_3" To="[reviewReason]" Value="[$&quot;{invoiceNumber}: {checkReason}&quot;]" />
                                      </Sequence>
                                    </If.Then>
                                  </If>
                                </If.Else>
                              </If>
                            </Sequence>
                          </Switch.Default>
                          <If Condition="[errorReason = &quot;&quot;]" x:Key="Error" DisplayName="First Technical Error?" sap2010:WorkflowViewState.IdRef="If_6">
                            <If.Then>
                              <Assign x:TypeArguments="x:String" DisplayName="Set Error Reason" sap2010:WorkflowViewState.IdRef="Assign`1_5" To="[errorReason]" Value="[$&quot;{Path.GetFileName(pdfFile)}: {readReason}&quot;]" />
                            </If.Then>
                          </If>
                          <If Condition="[reviewClass = &quot;&quot;]" x:Key="Scanned" DisplayName="First Problem?" sap2010:WorkflowViewState.IdRef="If_7">
                            <If.Then>
                              <Sequence DisplayName="Remember Scanned PDF" sap2010:WorkflowViewState.IdRef="Sequence_3">
                                <Assign x:TypeArguments="x:String" DisplayName="Set Review Class" sap2010:WorkflowViewState.IdRef="Assign`1_6" To="[reviewClass]" Value="[&quot;Scanned invoice&quot;]" />
                                <Assign x:TypeArguments="x:String" DisplayName="Set Review Reason" sap2010:WorkflowViewState.IdRef="Assign`1_7" To="[reviewReason]" Value="[$&quot;{Path.GetFileName(pdfFile)}: {readReason}&quot;]" />
                              </Sequence>
                            </If.Then>
                          </If>
                          <Assign x:TypeArguments="x:Int32" x:Key="NotInvoice" DisplayName="Count Other Document" sap2010:WorkflowViewState.IdRef="Assign`1_8" To="[notInvoiceCount]" Value="[notInvoiceCount + 1]" />
                        </Switch>
                      </Sequence>
                    </ActivityAction>
                  </ui:ForEach.Body>
                </ui:ForEach>
                <Assign x:TypeArguments="x:String" DisplayName="Set Invoice Numbers" sap2010:WorkflowViewState.IdRef="Assign`1_17" To="[out_InvoiceNumbers]" Value="[String.Join(&quot;, &quot;, invoiceNumbers)]" />
                <If Condition="[out_Class = &quot;&quot; AndAlso (errorReason &lt;&gt; &quot;&quot;)]" DisplayName="Rule 9: Technical Error In a PDF?" sap2010:WorkflowViewState.IdRef="If_10">
                  <If.Then>
                    <Sequence DisplayName="Set Result" sap2010:WorkflowViewState.IdRef="Sequence_6">
                      <Assign x:TypeArguments="x:String" DisplayName="Set Class" sap2010:WorkflowViewState.IdRef="Assign`1_18" To="[out_Class]" Value="[&quot;Technical error&quot;]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Set Reason" sap2010:WorkflowViewState.IdRef="Assign`1_19" To="[out_Reason]" Value="[errorReason]" />
                    </Sequence>
                  </If.Then>
                </If>
                <If Condition="[out_Class = &quot;&quot; AndAlso reviewClass &lt;&gt; &quot;&quot;]" DisplayName="Rule 10: Business Problem?" sap2010:WorkflowViewState.IdRef="If_11">
                  <If.Then>
                    <Sequence DisplayName="Set Result" sap2010:WorkflowViewState.IdRef="Sequence_7">
                      <Assign x:TypeArguments="x:String" DisplayName="Set Class" sap2010:WorkflowViewState.IdRef="Assign`1_20" To="[out_Class]" Value="[reviewClass]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Set Reason" sap2010:WorkflowViewState.IdRef="Assign`1_21" To="[out_Reason]" Value="[reviewReason]" />
                    </Sequence>
                  </If.Then>
                </If>
                <If Condition="[out_Class = &quot;&quot; AndAlso okInvoices.Count &gt; 0]" DisplayName="Rule 11: Correct Invoices?" sap2010:WorkflowViewState.IdRef="If_12">
                  <If.Then>
                    <Sequence DisplayName="Accept Invoices" sap2010:WorkflowViewState.IdRef="Sequence_8">
                      <Assign x:TypeArguments="x:String" DisplayName="Set Class" sap2010:WorkflowViewState.IdRef="Assign`1_22" To="[out_Class]" Value="[If(okInvoices.Count &gt; 1, $&quot;Invoice ({okInvoices.Count})&quot;, &quot;Invoice&quot;)]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Set Reason" sap2010:WorkflowViewState.IdRef="Assign`1_23" To="[out_Reason]" Value="[&quot;All checks passed&quot;]" />
                      <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="For Each Correct Invoice" sap2010:WorkflowViewState.IdRef="ForEach`1_3" Values="[okInvoices]">
                        <ui:ForEach.Body>
                          <ActivityAction x:TypeArguments="x:String">
                            <ActivityAction.Argument>
                              <DelegateInArgument x:TypeArguments="x:String" Name="invoiceKey" />
                            </ActivityAction.Argument>
                            <ui:AddDataRow DataRow="{x:Null}" ArrayRow="[{invoiceKey.Split(&quot;|&quot;c)(0), invoiceKey.Split(&quot;|&quot;c)(1), &quot;this run: &quot; &amp; in_Email.Subject}]" DataTable="[in_History]" DisplayName="Add To History" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
                          </ActivityAction>
                        </ui:ForEach.Body>
                      </ui:ForEach>
                    </Sequence>
                  </If.Then>
                </If>
                <If Condition="[out_Class = &quot;&quot; AndAlso (True)]" DisplayName="Rule 12: Only Other Documents" sap2010:WorkflowViewState.IdRef="If_13">
                  <If.Then>
                    <Sequence DisplayName="Set Result" sap2010:WorkflowViewState.IdRef="Sequence_9">
                      <Assign x:TypeArguments="x:String" DisplayName="Set Class" sap2010:WorkflowViewState.IdRef="Assign`1_24" To="[out_Class]" Value="[&quot;Not an invoice&quot;]" />
                      <Assign x:TypeArguments="x:String" DisplayName="Set Reason" sap2010:WorkflowViewState.IdRef="Assign`1_25" To="[out_Reason]" Value="[&quot;The PDF is not an invoice, for example a delivery note&quot;]" />
                    </Sequence>
                  </If.Then>
                </If>
              </Sequence>
            </If.Then>
          </If>
        </Sequence>
      </If.Then>
    </If>
    <If Condition="[out_Class = &quot;Not an invoice&quot;]" DisplayName="Which Folder?" sap2010:WorkflowViewState.IdRef="If_29">
      <If.Then>
        <Assign x:TypeArguments="x:String" DisplayName="Stay In Inbox" sap2010:WorkflowViewState.IdRef="Assign`1_58" To="[out_Folder]" Value="[in_Config(&quot;Folder_Inbox&quot;)]" />
      </If.Then>
      <If.Else>
        <If Condition="[out_Class = &quot;Technical error&quot;]" DisplayName="Error Folder?" sap2010:WorkflowViewState.IdRef="If_28">
          <If.Then>
            <Assign x:TypeArguments="x:String" DisplayName="Use Error Folder" sap2010:WorkflowViewState.IdRef="Assign`1_59" To="[out_Folder]" Value="[in_Config(&quot;Folder_Error&quot;)]" />
          </If.Then>
          <If.Else>
            <If Condition="[out_Class.StartsWith(&quot;Invoice&quot;) OrElse out_Class = &quot;Already handled&quot;]" DisplayName="Processed Folder?" sap2010:WorkflowViewState.IdRef="If_27">
              <If.Then>
                <Assign x:TypeArguments="x:String" DisplayName="Use Processed Folder" sap2010:WorkflowViewState.IdRef="Assign`1_60" To="[out_Folder]" Value="[in_Config(&quot;Folder_Processed&quot;)]" />
              </If.Then>
              <If.Else>
                <Assign x:TypeArguments="x:String" DisplayName="Use Review Folder" sap2010:WorkflowViewState.IdRef="Assign`1_61" To="[out_Folder]" Value="[in_Config(&quot;Folder_Review&quot;)]" />
              </If.Else>
            </If>
          </If.Else>
        </If>
      </If.Else>
    </If>
  </Sequence>
</Activity>
