  <Sequence DisplayName="Outlook Smoke Test" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="scg:List(umm:Office365Message)" Name="inboxEmails" />
      <Variable x:TypeArguments="umm:Office365Message" Name="invoiceEmail" />
      <Variable x:TypeArguments="x:String" Name="attachmentFolder" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <umam:GetEmailListConnections ConnectionId="1c702018-5e37-436e-8ec9-9ba68419b88b" DisplayName="Get Inbox Emails" EmailList="[inboxEmails]" IncludeAttachments="None" IncludeSubfolders="False" MarkAsRead="False" MaxResults="0" UnreadOnly="False" UseConnectionService="True" WithAttachmentsOnly="False">
      <umam:GetEmailListConnections.FilterSelectionBackup>
        <usau:BackupSlot x:TypeArguments="umame:FilterMode" StoredValue="ConditionBuilder">
          <usau:BackupSlot.BackupValues>
            <scg:Dictionary x:TypeArguments="umame:FilterMode, scg:List(x:Object)" />
          </usau:BackupSlot.BackupValues>
        </usau:BackupSlot>
      </umam:GetEmailListConnections.FilterSelectionBackup>
      <umam:GetEmailListConnections.MailFolderArgument>
        <umamm:MailFolderArgument SelectionMode="EnterPath">
          <umamm:MailFolderArgument.Backup>
            <usau:BackupSlot x:TypeArguments="umame:ItemSelectionMode" StoredValue="EnterPath">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umame:ItemSelectionMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umamm:MailFolderArgument.Backup>
          <umamm:MailFolderArgument.ManualEntryFolder>
            <InArgument x:TypeArguments="x:String">["Inbox"]</InArgument>
          </umamm:MailFolderArgument.ManualEntryFolder>
        </umamm:MailFolderArgument>
      </umam:GetEmailListConnections.MailFolderArgument>
      <umam:GetEmailListConnections.MailboxArg>
        <umamm:MailboxArgument UseSharedMailbox="True">
          <umamm:MailboxArgument.Backup>
            <usau:BackupSlot x:TypeArguments="umame:MailboxSelectionMode" StoredValue="NoMailbox">
              <usau:BackupSlot.BackupValues>
                <scg:Dictionary x:TypeArguments="umame:MailboxSelectionMode, scg:List(x:Object)" />
              </usau:BackupSlot.BackupValues>
            </usau:BackupSlot>
          </umamm:MailboxArgument.Backup>
          <umamm:MailboxArgument.SharedMailbox>
            <InArgument x:TypeArguments="x:String">["fakturor@stockholmdemohospital.onmicrosoft.com"]</InArgument>
          </umamm:MailboxArgument.SharedMailbox>
        </umamm:MailboxArgument>
      </umam:GetEmailListConnections.MailboxArg>
    </umam:GetEmailListConnections>
    <ui:LogMessage Level="Info" DisplayName="Log Email Count">
      <ui:LogMessage.Message>
        <InArgument x:TypeArguments="x:Object">
          <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;Emails in Inbox: {inboxEmails.Count}, unread: {inboxEmails.Where(Function(m) Not m.IsRead).Count()}&quot;" />
        </InArgument>
      </ui:LogMessage.Message>
    </ui:LogMessage>
    <ui:ForEach x:TypeArguments="umm:Office365Message" DisplayName="For Each Email">
      <ui:ForEach.Values>
        <InArgument x:TypeArguments="sc:IEnumerable">
          <VisualBasicValue x:TypeArguments="sc:IEnumerable" ExpressionText="inboxEmails" />
        </InArgument>
      </ui:ForEach.Values>
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="umm:Office365Message">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="umm:Office365Message" Name="email" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body">
            <ui:LogMessage Level="Info" DisplayName="Log Subject">
              <ui:LogMessage.Message>
                <InArgument x:TypeArguments="x:Object">
                  <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;{email.ReceivedDateTime:yyyy-MM-dd HH:mm} | {email.FromAddress} | {email.Subject} | attachments: {email.StandardAttachmentCount}&quot;" />
                </InArgument>
              </ui:LogMessage.Message>
            </ui:LogMessage>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <Assign x:TypeArguments="umm:Office365Message" DisplayName="Find Invoice 49838">
      <Assign.To>
        <OutArgument x:TypeArguments="umm:Office365Message">
          <VisualBasicReference x:TypeArguments="umm:Office365Message" ExpressionText="invoiceEmail" />
        </OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="umm:Office365Message">
          <VisualBasicValue x:TypeArguments="umm:Office365Message" ExpressionText="inboxEmails.FirstOrDefault(Function(m) m.Subject = &quot;Faktura 49838 från Norrlands Livsmedelsgrossist AB&quot;)" />
        </InArgument>
      </Assign.Value>
    </Assign>
    <If DisplayName="Invoice Email Found?">
      <If.Condition>
        <InArgument x:TypeArguments="x:Boolean">
          <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="invoiceEmail IsNot Nothing" />
        </InArgument>
      </If.Condition>
      <If.Then>
        <Sequence DisplayName="Then">
          <Assign x:TypeArguments="x:String" DisplayName="Set Attachment Folder">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">
                <VisualBasicReference x:TypeArguments="x:String" ExpressionText="attachmentFolder" />
              </OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">
                <VisualBasicValue x:TypeArguments="x:String" ExpressionText="Path.Combine(Environment.CurrentDirectory, &quot;Output&quot;, &quot;Attachments&quot;)" />
              </InArgument>
            </Assign.Value>
          </Assign>
          <ui:CreateDirectory DisplayName="Create Attachment Folder" Path="[attachmentFolder]" />
          <umam:DownloadEmailAttachments ConnectionId="1c702018-5e37-436e-8ec9-9ba68419b88b" ConflictResolution="Replace" DestinationPath="[attachmentFolder]" DisplayName="Download Invoice PDF" Email="[invoiceEmail]" ExcludeInlineAttachments="True" SearchMode="UseSimple" UseConnectionService="True" />
          <ui:LogMessage Level="Info" DisplayName="Log Saved Files">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">
                <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="$&quot;Saved in {attachmentFolder}: {String.Join(&quot;, &quot;, Directory.GetFiles(attachmentFolder).Select(Function(f) $&quot;{Path.GetFileName(f)} ({New FileInfo(f).Length} bytes)&quot;))}&quot;" />
                </InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else">
          <ui:LogMessage Level="Warn" DisplayName="Log Not Found">
            <ui:LogMessage.Message>
              <InArgument x:TypeArguments="x:Object">
                <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;Invoice email 49838 was not found in the Inbox.&quot;" />
              </InArgument>
            </ui:LogMessage.Message>
          </ui:LogMessage>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>
